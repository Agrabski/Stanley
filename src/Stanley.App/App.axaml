<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockFluent="using:Dock.Avalonia.Themes.Fluent"
             x:Class="Stanley.App.App">
  <Application.Styles>
    <FluentTheme />
    <dockFluent:DockFluentTheme />
    <!-- ColorView, behind "More Colors…" in the fill and outline menus. -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://Stanley.Editors/RibbonStyles.axaml" />
  </Application.Styles>
</Application>
