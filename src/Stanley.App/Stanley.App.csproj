<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>stanley</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Releases are tagged vX.Y.Z by release-please; any other commit gets
         <next patch>-alpha.0.<commits since the tag>, e.g. 0.1.1-alpha.0.7. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stanley.Editing\Stanley.Editing.csproj" />
    <ProjectReference Include="..\Stanley.EditorFramework\Stanley.EditorFramework.csproj" />
    <ProjectReference Include="..\Stanley.Editors\Stanley.Editors.csproj" />
    <ProjectReference Include="..\Stanley.ProjectModel\Stanley.ProjectModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.6" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.6" />
    <!-- Build-time only: sets Version from the latest vX.Y.Z git tag (see "Versioning" in CLAUDE.md). -->
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

</Project>
