<!--
  The page editor's ribbon: Word-style tabs (Home / Insert / Layout / View) plus
  contextual tabs (Panel, Bubble) that appear only while a comic panel or a bubble is
  selected. Hosted by the window's ribbon bar whenever a page editor is the active pane,
  with that pane's PageEditorViewModel as DataContext. The window overlays its File
  button on the left end of the tab strip, which is why the strip starts indented.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             xmlns:bubbles="using:Stanley.ProjectModel.Bubbles"
             xmlns:characters="using:Stanley.ProjectModel.Characters"
             x:Class="Stanley.Editors.PageEditorRibbon"
             x:DataType="local:PageEditorViewModel">
  <TabControl Name="Tabs" Classes="ribbonTabs">
    <TabControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Margin="64,0,0,0" />
      </ItemsPanelTemplate>
    </TabControl.ItemsPanel>

    <!-- ============================== HOME ============================== -->
    <TabItem Name="HomeTab" Header="Home">
      <StackPanel Classes="tabContent">
        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <RadioButton Name="SelectToolButton" Classes="tool" GroupName="Tool" Theme="{StaticResource {x:Type ToggleButton}}"
                         IsChecked="{Binding IsSelectTool}" ToolTip.Tip="Select, move and resize panels and bubbles (V)">
              <StackPanel><PathIcon Data="M5,2 L5,19 L9.5,14.5 L12.7,21.5 L15.3,20.3 L12.1,13.4 L18.5,13.4 Z" /><TextBlock Text="Select" /></StackPanel>
            </RadioButton>
            <RadioButton Name="PanelToolButton" Classes="tool" GroupName="Tool" Theme="{StaticResource {x:Type ToggleButton}}"
                         IsChecked="{Binding IsPanelTool}" ToolTip.Tip="Draw a new panel by dragging on the page (P)">
              <StackPanel><PathIcon Data="M2,2 H22 V22 H2 Z M4,4 V11 H11 V4 Z M13,4 V11 H20 V4 Z M4,13 V20 H20 V13 Z" /><TextBlock Text="Panel" /></StackPanel>
            </RadioButton>
            <RadioButton Name="BubbleToolButton" Classes="tool" GroupName="Tool" Theme="{StaticResource {x:Type ToggleButton}}"
                         IsChecked="{Binding IsBubbleTool}" ToolTip.Tip="Click inside a panel to add a speech bubble (B)">
              <StackPanel><PathIcon Data="M12,3 C6.5,3 2,6.6 2,11 C2,13.6 3.6,15.9 6,17.3 L5,21.5 L9.8,18.6 C10.5,18.8 11.3,18.9 12,18.9 C17.5,18.9 22,15.3 22,11 C22,6.6 17.5,3 12,3 Z" /><TextBlock Text="Bubble" /></StackPanel>
            </RadioButton>
            <RadioButton Name="PanToolButton" Classes="tool" GroupName="Tool" Theme="{StaticResource {x:Type ToggleButton}}"
                         IsChecked="{Binding IsPanTool}" ToolTip.Tip="Move around the page (H, or hold Space)">
              <StackPanel><PathIcon Data="M12,1 L15.5,4.5 H13 V11 H19.5 V8.5 L23,12 L19.5,15.5 V13 H13 V19.5 H15.5 L12,23 L8.5,19.5 H11 V13 H4.5 V15.5 L1,12 L4.5,8.5 V11 H11 V4.5 H8.5 Z" /><TextBlock Text="Pan" /></StackPanel>
            </RadioButton>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Tools" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <StackPanel Spacing="1">
            <RadioButton Classes="small" GroupName="HomeBubbleStyle" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsSpeechStyle}"
                         ToolTip.Tip="Rounded speech bubble (the selected bubble, and new ones)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="4"><PathIcon Data="{StaticResource SpeechIcon}" /><TextBlock Text="Speech" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="small" GroupName="HomeBubbleStyle" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsShoutStyle}"
                         ToolTip.Tip="Spiky shout bubble" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="4"><PathIcon Data="{StaticResource ShoutIcon}" /><TextBlock Text="Shout" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="small" GroupName="HomeBubbleStyle" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsWhisperStyle}"
                         ToolTip.Tip="Dashed whisper bubble" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="4"><PathIcon Data="{StaticResource WhisperIcon}" /><TextBlock Text="Whisper" /></StackPanel>
            </RadioButton>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Bubble style" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <Button Name="AddBubbleButton" Classes="tool" Command="{Binding AddBubbleCommand}" ToolTip.Tip="Add a bubble to the selected panel and start typing">
              <StackPanel><PathIcon Data="{StaticResource AddBubbleIcon}" /><TextBlock Text="Add bubble" /></StackPanel>
            </Button>
            <Button Classes="tool" Command="{Binding EditTextCommand}" ToolTip.Tip="Edit the selected bubble's text (Enter, or double-click the bubble)">
              <StackPanel><PathIcon Data="{StaticResource TextIcon}" /><TextBlock Text="Edit text" /></StackPanel>
            </Button>
            <Button Name="DeleteButton" Classes="tool" Command="{Binding DeleteSelectionCommand}" ToolTip.Tip="Delete the selected bubble or panel (Delete)">
              <StackPanel><PathIcon Data="{StaticResource DeleteIcon}" /><TextBlock Text="Delete" /></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Edit" />
        </DockPanel>
      </StackPanel>
    </TabItem>

    <!-- ============================== INSERT ============================== -->
    <TabItem Name="InsertTab" Header="Insert">
      <StackPanel Classes="tabContent">
        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <Button Name="DrawPanelButton" Classes="tool" Command="{Binding DrawPanelCommand}" ToolTip.Tip="Drag on the page to draw a new panel (P)">
              <StackPanel><PathIcon Data="M2,2 H22 V22 H2 Z M4,4 V11 H11 V4 Z M13,4 V11 H20 V4 Z M4,13 V20 H20 V13 Z" /><TextBlock Text="Panel" /></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Panels" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <Button Name="InsertSpeechButton" Classes="tool" Command="{Binding InsertBubbleCommand}" CommandParameter="{x:Static bubbles:BubbleStylePreset.Speech}"
                    ToolTip.Tip="Insert a speech bubble into the selected panel">
              <StackPanel><PathIcon Data="{StaticResource SpeechIcon}" /><TextBlock Text="Speech" /></StackPanel>
            </Button>
            <Button Name="InsertShoutButton" Classes="tool" Command="{Binding InsertBubbleCommand}" CommandParameter="{x:Static bubbles:BubbleStylePreset.Shout}"
                    ToolTip.Tip="Insert a shout bubble into the selected panel">
              <StackPanel><PathIcon Data="{StaticResource ShoutIcon}" /><TextBlock Text="Shout" /></StackPanel>
            </Button>
            <Button Name="InsertWhisperButton" Classes="tool" Command="{Binding InsertBubbleCommand}" CommandParameter="{x:Static bubbles:BubbleStylePreset.Whisper}"
                    ToolTip.Tip="Insert a whisper bubble into the selected panel">
              <StackPanel><PathIcon Data="{StaticResource WhisperIcon}" /><TextBlock Text="Whisper" /></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Bubbles" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group" IsVisible="{Binding HasCharacterCatalog}">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <ScrollViewer MaxWidth="260" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding HasCharacterChoices}">
              <ItemsControl Name="CharacterGallery" ItemsSource="{Binding CharacterChoices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="characters:CharacterDefinition">
                    <Button Classes="small" Width="48" Height="62" Padding="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Command="{Binding $parent[ItemsControl].((local:PageEditorViewModel)DataContext).InsertCharacterCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="{Binding Name, StringFormat='Put {0} in the selected panel (or drag from the Characters pane)'}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="9" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:CharacterFigure Character="{Binding}" />
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button Name="NewCharacterButton" Classes="tool" Command="{Binding NewCharacterCommand}" ToolTip.Tip="Create a new character and put it in the selected panel - double-click it to shape its body">
              <StackPanel><PathIcon Data="{StaticResource CharacterIcon}" /><TextBlock Text="New character" /></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Characters" />
        </DockPanel>
        <Rectangle Classes="divider" IsVisible="{Binding HasCharacterCatalog}" />

        <DockPanel Classes="group" IsVisible="{Binding HasPageNumbering}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource PageNumberIcon}" Width="22" Height="22" VerticalAlignment="Top" Margin="4,6,0,0" />
            <StackPanel Spacing="4" Margin="0,2,0,0">
              <ComboBox Name="PageNumberPositionBox" ItemsSource="{Binding PageNumberOptions}" SelectedItem="{Binding PageNumberOption}"
                        Width="190" Height="26" FontSize="12" Focusable="False"
                        ToolTip.Tip="Print page numbers on every page of the comic (not just this one)" />
              <StackPanel Orientation="Horizontal" Spacing="10" IsEnabled="{Binding PageNumbersEnabled}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Start at" FontSize="12" VerticalAlignment="Center" />
                  <NumericUpDown Name="PageNumberStartInput" Minimum="0" Maximum="9999" Increment="1" FormatString="0" Width="110" Height="26" FontSize="12"
                                 ToolTip.Tip="The number the first page would carry - to continue numbering from an earlier book" />
                </StackPanel>
                <CheckBox Name="NumberFirstPageCheck" IsChecked="{Binding NumberFirstPage}" Focusable="False" FontSize="12" Content="On first page"
                          ToolTip.Tip="Covers usually aren't numbered; the cover still counts as page 1" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Page numbers" />
        </DockPanel>
      </StackPanel>
    </TabItem>

    <!-- ============================== LAYOUT ============================== -->
    <TabItem Name="LayoutTab" Header="Layout">
      <StackPanel Classes="tabContent">
        <DockPanel Classes="group">
          <StackPanel Name="LayoutGallery" Orientation="Horizontal" Height="60" Spacing="2" />
          <TextBlock Classes="groupLabel" Text="Page layout" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="6" VerticalAlignment="Center">
              <TextBlock Text="Margin" FontSize="12" VerticalAlignment="Center" />
              <NumericUpDown Name="MarginInput" Grid.Column="1" Minimum="0" Maximum="40" Increment="1" FormatString="0.# mm" Width="130" Height="26" FontSize="12"
                             ToolTip.Tip="Distance from the page edge to the panel area" />
              <TextBlock Grid.Row="1" Text="Gutter" FontSize="12" VerticalAlignment="Center" />
              <NumericUpDown Name="GutterInput" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="20" Increment="0.5" FormatString="0.# mm" Width="130" Height="26" FontSize="12"
                             ToolTip.Tip="Space between neighbouring panels" />
            </Grid>
            <ToggleButton Name="SnapButton" Classes="tool" IsChecked="{Binding SnapEnabled}" ToolTip.Tip="Snap panel edges to the page margin and a gutter's width from other panels (hold Alt while dragging to place freely)">
              <StackPanel><PathIcon Data="M4,3 H9 V12 A3,3 0 0 0 15,12 V3 H20 V12 A8,8 0 0 1 4,12 Z M4,5 H9 V7 H4 Z M15,5 H20 V7 H15 Z" /><TextBlock Text="Snap" /></StackPanel>
            </ToggleButton>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Spacing" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <Button Classes="tool" Command="{Binding SplitColumnsCommand}" ToolTip.Tip="Split the selected panel into two side-by-side panels">
              <StackPanel><PathIcon Data="{StaticResource ColumnsIcon}" /><TextBlock Text="Columns" /></StackPanel>
            </Button>
            <Button Classes="tool" Command="{Binding SplitRowsCommand}" ToolTip.Tip="Split the selected panel into two stacked panels">
              <StackPanel><PathIcon Data="{StaticResource RowsIcon}" /><TextBlock Text="Rows" /></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Split panel" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <ToggleButton Name="LockLayoutButton" Classes="tool" IsChecked="{Binding IsLayoutLocked}" ToolTip.Tip="Prevent panels on this page from being moved, resized, split, deleted or re-tiled - bubbles and characters are unaffected">
              <StackPanel><PathIcon Data="{StaticResource LockIcon}" /><TextBlock Text="Lock layout" /></StackPanel>
            </ToggleButton>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Protect" />
        </DockPanel>
      </StackPanel>
    </TabItem>

    <!-- ============================== VIEW ============================== -->
    <TabItem Name="ViewTab" Header="View">
      <StackPanel Classes="tabContent">
        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <Button Classes="tool" Command="{Binding FitPageCommand}" ToolTip.Tip="Show the whole page (Ctrl+0)">
              <StackPanel><PathIcon Data="M3,3 H9 V5 H5 V9 H3 Z M15,3 H21 V9 H19 V5 H15 Z M3,15 H5 V19 H9 V21 H3 Z M19,15 H21 V21 H15 V19 H19 Z M8,8 H16 V16 H8 Z" /><TextBlock Text="Fit page" /></StackPanel>
            </Button>
            <Button Classes="tool" Command="{Binding ActualSizeCommand}" ToolTip.Tip="Show the page at its printed size (Ctrl+1)">
              <StackPanel><TextBlock Text="1:1" FontSize="15" FontWeight="SemiBold" Margin="0" /><TextBlock Text="Actual size" /></StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
              <Button Classes="small" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out (Ctrl+−, or Ctrl+scroll)" FontSize="16">−</Button>
              <TextBlock Name="ZoomText" Width="52" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding ZoomText}" />
              <Button Classes="small" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in (Ctrl++, or Ctrl+scroll)" FontSize="16">+</Button>
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Zoom" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <StackPanel VerticalAlignment="Center" Spacing="4" Margin="0,6,0,0">
            <CheckBox Name="MarginGuidesCheck" IsChecked="{Binding ShowMarginGuides}" Focusable="False" FontSize="12" Content="Margin guides" />
            <CheckBox IsChecked="{Binding SnapEnabled}" Focusable="False" FontSize="12" Content="Snap to margins and gutters" />
            <CheckBox IsChecked="{Binding IsLayoutLocked}" Focusable="False" FontSize="12" Content="Lock layout" />
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Show" />
        </DockPanel>
      </StackPanel>
    </TabItem>

    <!-- ============================== PANEL (contextual) ============================== -->
    <TabItem Name="PanelTab" Classes="contextual panel" IsVisible="{Binding IsPanelContext}">
      <TabItem.Header><TextBlock Classes="panelHeader" Text="Panel" /></TabItem.Header>
      <StackPanel Classes="tabContent">
        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <Button Name="SplitColumnsButton" Classes="tool" Command="{Binding SplitColumnsCommand}" ToolTip.Tip="Split this panel into two side-by-side panels">
              <StackPanel><PathIcon Data="{StaticResource ColumnsIcon}" /><TextBlock Text="Columns" /></StackPanel>
            </Button>
            <Button Name="SplitRowsButton" Classes="tool" Command="{Binding SplitRowsCommand}" ToolTip.Tip="Split this panel into two stacked panels">
              <StackPanel><PathIcon Data="{StaticResource RowsIcon}" /><TextBlock Text="Rows" /></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Split" />
        </DockPanel>
        <Rectangle Classes="divider" />
        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <Button Classes="tool" Command="{Binding AddBubbleCommand}" ToolTip.Tip="Add a bubble to this panel and start typing">
              <StackPanel><PathIcon Data="{StaticResource AddBubbleIcon}" /><TextBlock Text="Add bubble" /></StackPanel>
            </Button>
            <Button Name="DeletePanelButton" Classes="tool" Command="{Binding DeleteSelectionCommand}" ToolTip.Tip="Delete this panel and its bubbles (Delete)">
              <StackPanel><PathIcon Data="{StaticResource DeleteIcon}" /><TextBlock Text="Delete" /></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Panel" />
        </DockPanel>
      </StackPanel>
    </TabItem>

    <!-- ============================== CHARACTER (contextual) ============================== -->
    <TabItem Name="CharacterTab" Classes="contextual character" IsVisible="{Binding IsCharacterContext}">
      <TabItem.Header><TextBlock Classes="characterHeader" Text="Character" /></TabItem.Header>
      <StackPanel Classes="tabContent">
        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <Button Name="EditCharacterButton" Classes="tool" Command="{Binding EditCharacterCommand}" ToolTip.Tip="Edit this character's body - every panel it's in follows (or double-click it)">
              <StackPanel><PathIcon Data="{StaticResource CharacterIcon}" /><TextBlock Text="Edit body" /></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="{Binding SelectedCharacterName}" />
        </DockPanel>
        <Rectangle Classes="divider" />
        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <RadioButton Name="FrontViewButton" Classes="tool" GroupName="CharacterView" Theme="{StaticResource {x:Type ToggleButton}}"
                         IsChecked="{Binding IsSelectedCharacterFront}" ToolTip.Tip="Facing the reader (F)">
              <StackPanel><PathIcon Data="{StaticResource CharacterIcon}" /><TextBlock Text="Front" /></StackPanel>
            </RadioButton>
            <RadioButton Name="SideViewButton" Classes="tool" GroupName="CharacterView" Theme="{StaticResource {x:Type ToggleButton}}"
                         IsChecked="{Binding IsSelectedCharacterSide}" ToolTip.Tip="Seen from the side (S) - Flip to face the other way">
              <StackPanel><PathIcon Data="{StaticResource SideViewIcon}" /><TextBlock Text="Side" /></StackPanel>
            </RadioButton>
            <Button Name="FlipCharacterButton" Classes="tool" Command="{Binding FlipCharacterCommand}" ToolTip.Tip="Face the other way">
              <StackPanel><PathIcon Data="{StaticResource FlipIcon}" /><TextBlock Text="Flip" /></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="View" />
        </DockPanel>
        <Rectangle Classes="divider" />
        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ScrollViewer MaxWidth="480" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl Name="PoseGallery" ItemsSource="{Binding PoseChoices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:PosePresetChoice">
                    <Button Classes="small" Width="41" Height="66" Padding="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Command="{Binding $parent[ItemsControl].((local:PageEditorViewModel)DataContext).ApplyPosePresetCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="{Binding Name, StringFormat='{}{0} - then adjust by dragging the green dots'}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="9" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:CharacterFigure Character="{Binding Character}" Pose="{Binding Pose}" />
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <Button Name="MirrorPoseButton" Classes="small" Command="{Binding MirrorPoseCommand}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="The same pose the other way round - wave with the other hand">Mirror</Button>
              <Button Name="ResetPoseButton" Classes="small" Command="{Binding ResetPoseCommand}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Stand at rest again">Reset</Button>
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Pose" />
        </DockPanel>
        <Rectangle Classes="divider" />
        <DockPanel Classes="group">
          <DropDownButton Name="ExpressionGallery" Classes="slotGallery" ToolTip.Tip="The face: happy, sad, surprised... (for this panel only)">
            <StackPanel Spacing="1">
              <TextBlock Text="Face" FontSize="12" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding SelectedExpressionName}" FontSize="9" Opacity="0.7" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="64" />
            </StackPanel>
            <DropDownButton.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <ItemsControl Name="ExpressionChoices" ItemsSource="{Binding ExpressionChoices}" MaxWidth="320">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ExpressionPresetChoice">
                      <Button Classes="small choice sticker closeup" Classes.worn="{Binding IsCurrent}" Margin="1" Padding="2"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                              Command="{Binding $parent[ItemsControl].((local:PageEditorViewModel)DataContext).ApplyExpressionCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="9" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <local:CharacterFigure Character="{Binding Character}" Pose="{Binding Pose}" Closeup="True" />
                        </DockPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <TextBlock Classes="groupLabel" Text="Expression" />
        </DockPanel>
        <Rectangle Classes="divider" />
        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <Button Name="BiggerCharacterButton" Classes="small" Command="{Binding BiggerCharacterCommand}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Closer to camera - every character in this panel at the same distance grows too, keeping their relative heights">Bigger</Button>
              <Button Name="SmallerCharacterButton" Classes="small" Command="{Binding SmallerCharacterCommand}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Further from camera - together with the panel's other characters">Smaller</Button>
              <Button Name="MatchSizeButton" Classes="small" Command="{Binding MatchCharacterSizeCommand}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Back to the same scale as the panel's other characters (after resizing it on its own with Shift)">Match size</Button>
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Size" />
        </DockPanel>
        <Rectangle Classes="divider" />
        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <Button Classes="small" Command="{Binding BringToFrontCommand}" ToolTip.Tip="In front of the panel's other characters (bubbles stay on top)" HorizontalAlignment="Stretch">To front</Button>
              <Button Classes="small" Command="{Binding SendToBackCommand}" ToolTip.Tip="Behind the panel's other characters" HorizontalAlignment="Stretch">To back</Button>
            </StackPanel>
            <Button Name="DeleteCharacterButton" Classes="tool" Command="{Binding DeleteSelectionCommand}" ToolTip.Tip="Remove from this panel (the character itself stays in the Characters pane)">
              <StackPanel><PathIcon Data="{StaticResource DeleteIcon}" /><TextBlock Text="Remove" /></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Arrange" />
        </DockPanel>
      </StackPanel>
    </TabItem>

    <!-- ============================== BUBBLE (contextual) ============================== -->
    <TabItem Name="BubbleTab" Classes="contextual bubble" IsVisible="{Binding IsBubbleContext}">
      <TabItem.Header><TextBlock Classes="bubbleHeader" Text="Bubble" /></TabItem.Header>
      <StackPanel Classes="tabContent">
        <DockPanel Classes="group">
          <StackPanel Spacing="1">
            <RadioButton Name="SpeechStyleButton" Classes="small" GroupName="BubbleTabStyle" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsSpeechStyle}"
                         ToolTip.Tip="Rounded speech bubble" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="4"><PathIcon Data="{StaticResource SpeechIcon}" /><TextBlock Text="Speech" /></StackPanel>
            </RadioButton>
            <RadioButton Name="ShoutStyleButton" Classes="small" GroupName="BubbleTabStyle" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsShoutStyle}"
                         ToolTip.Tip="Spiky shout bubble" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="4"><PathIcon Data="{StaticResource ShoutIcon}" /><TextBlock Text="Shout" /></StackPanel>
            </RadioButton>
            <RadioButton Name="WhisperStyleButton" Classes="small" GroupName="BubbleTabStyle" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsWhisperStyle}"
                         ToolTip.Tip="Dashed whisper bubble" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="4"><PathIcon Data="{StaticResource WhisperIcon}" /><TextBlock Text="Whisper" /></StackPanel>
            </RadioButton>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Style" />
        </DockPanel>
        <Rectangle Classes="divider" />
        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <Button Name="EditTextButton" Classes="tool" Command="{Binding EditTextCommand}" ToolTip.Tip="Edit the bubble's text (Enter, or double-click the bubble)">
              <StackPanel><PathIcon Data="{StaticResource TextIcon}" /><TextBlock Text="Edit text" /></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Text" />
        </DockPanel>
        <Rectangle Classes="divider" />
        <DockPanel Classes="group">
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <Button Name="AddTailButton" Classes="small" Command="{Binding AddTailCommand}" ToolTip.Tip="Add another tail - drag its orange tip onto the speaker" HorizontalAlignment="Stretch">Add tail</Button>
            <Button Name="RemoveTailButton" Classes="small" Command="{Binding RemoveTailCommand}" ToolTip.Tip="Remove the most recently added tail (right-click a tail to remove that one)" HorizontalAlignment="Stretch">Remove tail</Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Tails" />
        </DockPanel>
        <Rectangle Classes="divider" />
        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <Button Name="BringToFrontButton" Classes="small" Command="{Binding BringToFrontCommand}" ToolTip.Tip="Draw this bubble above the others in its panel" HorizontalAlignment="Stretch">To front</Button>
              <Button Name="SendToBackButton" Classes="small" Command="{Binding SendToBackCommand}" ToolTip.Tip="Draw this bubble below the others in its panel" HorizontalAlignment="Stretch">To back</Button>
            </StackPanel>
            <Button Name="DeleteBubbleButton" Classes="tool" Command="{Binding DeleteSelectionCommand}" ToolTip.Tip="Delete this bubble (Delete)">
              <StackPanel><PathIcon Data="{StaticResource DeleteIcon}" /><TextBlock Text="Delete" /></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Arrange" />
        </DockPanel>
      </StackPanel>
    </TabItem>
  </TabControl>
</UserControl>
