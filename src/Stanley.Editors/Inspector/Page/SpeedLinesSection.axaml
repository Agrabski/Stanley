<!--
  The selected speed lines: colour, how many and how thick, a fresh shuffle, layer and arrange -
  the ribbon's Speed Lines tab (SpeedLinesRibbonTab.axaml), bound to the same view-model members.
  Part of the canvas layout's inspector (docs/ui-shell.md §6).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.SpeedLinesSection"
             x:DataType="local:PageEditorViewModel" IsVisible="{Binding IsSpeedLinesContext}">
  <StackPanel>
    <Border Classes="inspectorSection">
      <StackPanel Spacing="6">
        <TextBlock Classes="sectionHeader" Text="Lines" />
        <local:ColorMenuButton Name="SpeedLinesColorButton" Label="Color"
                               Icon="{StaticResource ShapeFillIcon}" DefaultColor="#1c1c1c"
                               Command="{Binding SetSpeedLinesColorCommand}" MoreLabel="More Colors…"
                               CurrentColor="{Binding CurrentSpeedLinesStyle.Color}"
                               ToolTip.Tip="The lines' colour" />
        <DockPanel Classes="propertyRow">
          <TextBlock Classes="propertyLabel" Text="Lines" />
          <TextBlock DockPanel.Dock="Right" Width="40" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" TextAlignment="Right"
                     Text="{Binding SpeedLinesCount, StringFormat='{}{0:0}'}" />
          <Slider Name="SpeedLinesCountSlider" Minimum="8" Maximum="300" Value="{Binding SpeedLinesCount}"
                  local:DragGesture.Target="{Binding}"
                  ToolTip.Tip="How many lines radiate out - few for a subtle nudge, many for a full burst" />
        </DockPanel>
        <DockPanel Classes="propertyRow">
          <TextBlock Classes="propertyLabel" Text="Thickness" />
          <TextBlock DockPanel.Dock="Right" Width="40" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" TextAlignment="Right"
                     Text="{Binding SpeedLinesThickness, StringFormat='{}{0:0.0}mm'}" />
          <Slider Name="SpeedLinesThicknessSlider" Minimum="0.2" Maximum="4" Value="{Binding SpeedLinesThickness}"
                  local:DragGesture.Target="{Binding}"
                  ToolTip.Tip="How wide each line is at its outer end" />
        </DockPanel>
        <Button Name="ShuffleSpeedLinesButton" Classes="inspectorButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Command="{Binding ShuffleSpeedLinesCommand}"
                ToolTip.Tip="A fresh, differently jittered burst - same colour, count and thickness">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource ShuffleIcon}" /><TextBlock Text="Shuffle" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <Border Classes="inspectorSection">
      <StackPanel Spacing="6">
        <TextBlock Classes="sectionHeader" Text="Layer" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
          <RadioButton Name="SpeedLinesBehindButton" Classes="inspectorButton" Theme="{StaticResource {x:Type ToggleButton}}"
                       HorizontalAlignment="Stretch" IsChecked="{Binding IsElementBehind}"
                       ToolTip.Tip="Scenery: drawn behind the panel's characters">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource BehindIcon}" /><TextBlock Text="Background" />
            </StackPanel>
          </RadioButton>
          <RadioButton Name="SpeedLinesInFrontButton" Grid.Column="1" Classes="inspectorButton" Theme="{StaticResource {x:Type ToggleButton}}"
                       HorizontalAlignment="Stretch" IsChecked="{Binding IsElementInFront}"
                       ToolTip.Tip="Foreground: drawn in front of the panel's characters (bubbles stay on top)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource InFrontIcon}" /><TextBlock Text="Foreground" />
            </StackPanel>
          </RadioButton>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="inspectorSection">
      <StackPanel Spacing="6">
        <TextBlock Classes="sectionHeader" Text="Order" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
          <Button Name="SpeedLinesToFrontButton" Classes="inspectorButton" HorizontalAlignment="Stretch"
                  Command="{Binding BringToFrontCommand}"
                  ToolTip.Tip="In front of everything in the panel except bubbles">
            To front
          </Button>
          <Button Name="SpeedLinesToBackButton" Grid.Column="1" Classes="inspectorButton" HorizontalAlignment="Stretch"
                  Command="{Binding SendToBackCommand}" ToolTip.Tip="Behind everything in the panel">
            To back
          </Button>
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
