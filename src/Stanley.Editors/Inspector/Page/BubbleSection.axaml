<!--
  The selected bubble: style, lettering, text and tails.
  Part of the canvas layout's inspector (docs/ui-shell.md §6). 
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.BubbleSection"
             x:DataType="local:PageEditorViewModel" IsVisible="{Binding IsBubbleContext}">
  <Border Classes="inspectorSection">
    <StackPanel Spacing="6">
      <TextBlock Classes="sectionHeader" Text="Bubble" />
    </StackPanel>
  </Border>
</UserControl>
