<!--
  The selected panel: split, background, fill and border.
  Part of the canvas layout's inspector (docs/ui-shell.md §6). 
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.PanelSection"
             x:DataType="local:PageEditorViewModel" IsVisible="{Binding IsPanelContext}">
  <Border Classes="inspectorSection">
    <StackPanel Spacing="6">
      <TextBlock Classes="sectionHeader" Text="Panel" />
    </StackPanel>
  </Border>
</UserControl>
