<!--
  With a drawing tool in hand: the fill, outline and layer the next shape gets - the Home tab's
  Shape Fill and Shape Outline as they work with a drawing tool on (the view model's pen,
  CurrentShapeStyle with no shape selected). A shape just drawn and still selected has the
  Shape section instead.
  Part of the canvas layout's inspector (docs/ui-shell.md §6).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.PenSection"
             x:DataType="local:PageEditorViewModel">
  <UserControl.IsVisible>
    <MultiBinding Converter="{x:Static BoolConverters.And}">
      <Binding Path="IsShapeTool" />
      <Binding Path="!IsShapeContext" />
    </MultiBinding>
  </UserControl.IsVisible>
  <UserControl.Styles>
    <!-- Fill and Outline share a row here, so the colour buttons drop the ribbon's minimum width. -->
    <Style Selector="SplitButton.colorMenu">
      <Setter Property="MinWidth" Value="0" />
    </Style>
  </UserControl.Styles>
  <Border Classes="inspectorSection">
    <StackPanel Spacing="6">
      <TextBlock Classes="sectionHeader" Text="Pen" />
      <TextBlock Classes="inspectorHint" Text="How the next shape you draw looks." />
      <UniformGrid Columns="2" ColumnSpacing="4">
        <local:ColorMenuButton Name="PenFillButton" Label="Fill"
                               Icon="{StaticResource ShapeFillIcon}" DefaultColor="#4472c4"
                               IsEnabled="{Binding CanUseShapeStyles}"
                               Command="{Binding SetFillColorCommand}" NoneLabel="No Fill"
                               MoreLabel="More Fill Colors…"
                               CurrentColor="{Binding CurrentShapeStyle.Fill}"
                               ToolTip.Tip="Shape Fill - the colour inside the closed shapes you draw next" />
        <local:ColorMenuButton Name="PenOutlineButton" Label="Outline"
                               Icon="{StaticResource ShapeOutlineIcon}" DefaultColor="#000000"
                               IsEnabled="{Binding CanUseShapeStyles}"
                               Command="{Binding SetStrokeColorCommand}" NoneLabel="No Outline"
                               MoreLabel="More Outline Colors…"
                               CurrentColor="{Binding CurrentShapeStyle.Stroke}"
                               WeightCommand="{Binding SetStrokeWeightCommand}"
                               CurrentWeight="{Binding CurrentShapeStyle.StrokeWidthMm}"
                               DashCommand="{Binding SetStrokeDashCommand}"
                               CurrentDash="{Binding CurrentShapeStyle.Dash}"
                               ToolTip.Tip="Shape Outline - the colour, weight and dashes of what you draw next" />
      </UniformGrid>
      <DockPanel Classes="propertyRow">
        <TextBlock Classes="propertyLabel" Text="Layer" />
        <UniformGrid Columns="2" ColumnSpacing="4">
          <RadioButton Name="PenBehindButton" Classes="inspectorButton" GroupName="InspectorPenLayer"
                       Theme="{StaticResource {x:Type ToggleButton}}" HorizontalAlignment="Stretch"
                       IsChecked="{Binding IsElementBehind}"
                       ToolTip.Tip="Background - scenery, drawn behind the panel's characters">
            Behind
          </RadioButton>
          <RadioButton Name="PenInFrontButton" Classes="inspectorButton" GroupName="InspectorPenLayer"
                       Theme="{StaticResource {x:Type ToggleButton}}" HorizontalAlignment="Stretch"
                       IsChecked="{Binding IsElementInFront}"
                       ToolTip.Tip="Foreground - drawn in front of the panel's characters (bubbles stay on top)">
            In front
          </RadioButton>
        </UniformGrid>
      </DockPanel>
    </StackPanel>
  </Border>
</UserControl>
