<!--
  With a drawing tool in hand and nothing selected: the fill and outline the next shape gets.
  Part of the canvas layout's inspector (docs/ui-shell.md §6). 
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.PenSection"
             x:DataType="local:PageEditorViewModel" IsVisible="{Binding IsShapeTool}">
  <Border Classes="inspectorSection">
    <StackPanel Spacing="6">
      <TextBlock Classes="sectionHeader" Text="Pen" />
    </StackPanel>
  </Border>
</UserControl>
