<!--
  The character's body: body types, sliders, skin, name and view.
  Part of the canvas layout's inspector (docs/ui-shell.md §6). 
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.BodySection"
             x:DataType="local:CharacterEditorViewModel">
  <Border Classes="inspectorSection">
    <StackPanel Spacing="6">
      <TextBlock Classes="sectionHeader" Text="Body" />
    </StackPanel>
  </Border>
</UserControl>
