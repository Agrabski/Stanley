<!--
  The worn sticker picked on the stage: its fit, styles, colour and text.
  Part of the canvas layout's inspector (docs/ui-shell.md §6). 
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.StickerSection"
             x:DataType="local:CharacterEditorViewModel" IsVisible="{Binding HasSelectedSticker}">
  <Border Classes="inspectorSection">
    <StackPanel Spacing="6">
      <TextBlock Classes="sectionHeader" Text="Sticker" />
    </StackPanel>
  </Border>
</UserControl>
