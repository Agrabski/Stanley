<!--
  The name and body of a character built from shapes (docs/shape-characters.md §9.2): the
  creature presets, the four parts (a click picks one for the Module section, or puts a missing
  one back), joined or separate pieces, Height % and the skin. Shown in the Body section's place
  for such a character. Part of the canvas layout's inspector (docs/ui-shell.md §6); the
  ribbon's Shapes tab does the same.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.ShapesSection"
             x:DataType="local:CharacterEditorViewModel" IsVisible="{Binding IsModular}">
  <UserControl.Styles>
    <Style Selector="Slider.inspectorSlider">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="DockPanel.propertyRow > TextBlock.sliderValue">
      <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>
    <Style Selector="TextBlock.sliderValue">
      <Setter Property="Width" Value="50" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.skinSwatch">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>
  <Border Classes="inspectorSection">
    <StackPanel Spacing="6">
      <TextBlock Classes="sectionHeader" Text="Shapes" />

      <DockPanel Classes="propertyRow">
        <TextBlock Classes="propertyLabel" Text="Name" />
        <TextBox Name="NameBox" Height="28" MinHeight="0" Padding="6,0" FontSize="12" VerticalContentAlignment="Center"
                 Text="{Binding Name, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="The character's name (Enter to apply)" />
      </DockPanel>

      <!-- The creature presets, each previewed as this character: a whole body in one click. -->
      <DockPanel Classes="propertyRow">
        <TextBlock Classes="propertyLabel" Text="Creature" />
        <DropDownButton Name="CreatureButton" Classes="inspectorButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Content="Choose..." ToolTip.Tip="Build them as a ready-made creature - colours and what they wear stay; every part stays editable">
          <DropDownButton.Flyout>
            <Flyout Placement="LeftEdgeAlignedTop" ShowMode="Transient" Opening="OnGalleryOpening">
              <ItemsControl Name="CreatureGallery" ItemsSource="{Binding CreatureChoices}" MaxWidth="420">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:CreaturePresetChoice">
                    <Button Classes="small choice" Classes.worn="{Binding IsCurrent}" Width="48" Height="72" Padding="2" Margin="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Command="{Binding $parent[ItemsControl].((local:CharacterEditorViewModel)DataContext).ApplyCreatureCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="{Binding Tip}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="9" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:CharacterFigure Character="{Binding Preview}" />
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </DropDownButton.Flyout>
        </DropDownButton>
      </DockPanel>

      <!-- The parts: a click picks one (the section below), a missing one's + puts it back. -->
      <ItemsControl Name="PartButtons" ItemsSource="{Binding ModulePartChoices}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:ModulePartChoice">
            <Button Classes="small choice" Classes.worn="{Binding IsSelected}" Height="62" Padding="2" Margin="1" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Command="{Binding $parent[ItemsControl].((local:CharacterEditorViewModel)DataContext).PickModuleCommand}"
                    CommandParameter="{Binding}" ToolTip.Tip="{Binding Tip}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" />
                <local:ModuleShapeIcon Shape="{Binding Icon}" Aspect="{Binding Aspect}" Fill="{Binding Fill}" Margin="3" />
              </DockPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <DockPanel Classes="propertyRow">
        <TextBlock Classes="propertyLabel" Text="Pieces" />
        <StackPanel Orientation="Horizontal" Spacing="1">
          <RadioButton Name="JoinedButton" Classes="small" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsJoinedBody}"
                       ToolTip.Tip="Joined - the pieces meet seamlessly, one creature">Joined</RadioButton>
          <RadioButton Name="SeparateButton" Classes="small" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsSeparateBody}"
                       ToolTip.Tip="Separate - every piece keeps its own outline, like building blocks">Separate</RadioButton>
        </StackPanel>
      </DockPanel>

      <DockPanel Classes="propertyRow">
        <TextBlock Classes="propertyLabel" Text="Height" />
        <TextBlock Classes="sliderValue" Text="{Binding HeightText}" />
        <Slider Name="BodyHeightSlider" Classes="inspectorSlider" Minimum="{Binding MinBodyHeightPercent}" Maximum="{Binding MaxBodyHeightPercent}"
                Value="{Binding BodyHeightPercent}" ToolTip.Tip="How tall, relative to an average adult (100%) - every part grows or shrinks together" />
      </DockPanel>

      <StackPanel Spacing="2">
        <TextBlock Classes="propertyLabel" Text="Skin" HorizontalAlignment="Left" ToolTip.Tip="Every part without a colour of its own" />
        <DockPanel>
          <Button Name="MoreSkinColorsButton" DockPanel.Dock="Right" Classes="iconButton" VerticalAlignment="Top" Height="22"
                  ToolTip.Tip="More Colors… - pick any skin colour" Command="{Binding PickCustomSkinColorCommand}" CommandParameter="{Binding $self}">
            <UniformGrid Rows="2" Columns="2" Width="12" Height="12">
              <Border Background="#ed7d31" />
              <Border Background="#ffc000" />
              <Border Background="#4472c4" />
              <Border Background="#70ad47" />
            </UniformGrid>
          </Button>
          <ItemsControl Name="SkinSwatches" ItemsSource="{Binding SkinSwatches}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:SkinSwatch">
                <Button Classes="skinSwatch"
                        Command="{Binding $parent[ItemsControl].((local:CharacterEditorViewModel)DataContext).SetSkinCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}">
                  <Border Background="{Binding Brush}" BorderBrush="#60000000" BorderThickness="1" CornerRadius="2" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
