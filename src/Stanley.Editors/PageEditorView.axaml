<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.PageEditorView">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="*">
    <!-- Controls bar -->
    <Border Grid.Row="0" Padding="8" BorderBrush="LightGray" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="AddBubbleButton" Click="OnAddBubbleClick">Add Bubble</Button>
        <Button Name="SplitPanelButton" Click="OnSplitPanelClick">Split Panel</Button>
      </StackPanel>
    </Border>

    <!-- Main canvas -->
    <Grid Grid.Row="1">
      <local:PageCanvasControl x:Name="PageCanvas" />

      <!-- Text editing box (overlaid, positioned outside canvas typically) -->
      <StackPanel Margin="8" VerticalAlignment="Top" HorizontalAlignment="Right" Width="200">
        <TextBlock Text="Bubble Text:" Margin="0,0,0,4" />
        <TextBox Name="BubbleTextBox" Height="100" TextWrapping="Wrap" LostFocus="OnBubbleTextLostFocus" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
