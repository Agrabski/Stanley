<!--
  The page editor pane: the zoomable page, an inline text editor that opens over a
  bubble, and a status bar. Its ribbon is not in here - it's PageEditorRibbon, shown in
  the window's ribbon bar above the dock area whenever this pane is the active one.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.PageEditorView"
             x:DataType="local:PageEditorViewModel">
  <Grid RowDefinitions="*,Auto">
    <!-- Page -->
    <Grid Grid.Row="0">
      <local:PageCanvasControl x:Name="PageCanvas" />
      <!-- The text editor sits on the (always white) paper, so it stays light in dark mode too. -->
      <ThemeVariantScope RequestedThemeVariant="Light">
      <Canvas Name="Overlay">
        <TextBox Name="InlineTextEditor" IsVisible="False" AcceptsReturn="True" TextWrapping="Wrap" TextAlignment="Center"
                 VerticalContentAlignment="Center" Background="#F2FFFFFF" Foreground="Black" BorderThickness="2" MaxLength="500"
                 PlaceholderText="Type the dialogue…  (Enter = done, Shift+Enter = new line, Esc = cancel)" />
      </Canvas>
      </ThemeVariantScope>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="1" Classes="ribbon" BorderThickness="0,1,0,0" Padding="10,3">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Name="ErrorText" Text="{Binding LastError}" Foreground="{DynamicResource StanleyErrorBrush}" FontSize="12" VerticalAlignment="Center"
                     IsVisible="{Binding LastError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Name="HintText" Text="{Binding Hint}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Name="PageInfoText" Grid.Column="1" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
