<!--
  One colour slot's dropdown: a swatch button showing its colour and fabric, opening the
  colour, dye or pattern, and texture pickers. Used by the Look tab's Colours group (one
  per slot in use) and by the Sticker tab (the selected hair piece or streak), so both
  offer exactly the same thing. Its DataContext is a ColorSlotEditor.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.ColorSlotDropdown"
             x:DataType="local:ColorSlotEditor">
  <UserControl.Resources>
    <!-- A clothing pattern or tile, previewed in the slot's colour. -->
    <DataTemplate x:Key="PatternChoiceTemplate" x:DataType="local:FabricChoice">
      <Button Classes="small choice" Classes.worn="{Binding IsCurrent}" Width="46" Height="46" Padding="2" Margin="1"
              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
              Command="{Binding $parent[ItemsControl].((local:ColorSlotEditor)DataContext).SetPattern}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Label}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" FontSize="8" HorizontalAlignment="Center" />
          <Panel>
            <local:FabricSwatch Color="{Binding Ground}" Fabric="{Binding Preview}" Tiles="{Binding Tiles}" IsVisible="{Binding !IsCustom}" />
            <TextBlock Text="+" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsCustom}" />
          </Panel>
        </DockPanel>
      </Button>
    </DataTemplate>

    <!-- A hair dye (or none), drawn across the swatch. -->
    <DataTemplate x:Key="DyeChoiceTemplate" x:DataType="local:FabricChoice">
      <Button Classes="small choice" Classes.worn="{Binding IsCurrent}" Width="46" Height="46" Padding="2" Margin="1"
              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
              Command="{Binding $parent[ItemsControl].((local:ColorSlotEditor)DataContext).SetDye}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Label}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" FontSize="8" HorizontalAlignment="Center" />
          <local:FabricSwatch Color="{Binding Ground}" Fabric="{Binding Preview}" />
        </DockPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
    <DropDownButton Classes="colorSlot" Margin="1" ToolTip.Tip="{Binding Tip}">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <local:FabricSwatch Width="18" Height="14" Color="{Binding Color}" Fabric="{Binding Fabric}" Tiles="{Binding Tiles}" />
        <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" />
      </StackPanel>
      <DropDownButton.Flyout>
        <Flyout Placement="BottomEdgeAlignedLeft">
          <StackPanel Spacing="6" Width="340">
            <TextBlock Text="Colour" FontSize="11" FontWeight="SemiBold" />
            <StackPanel Spacing="4">
              <ItemsControl ItemsSource="{Binding Swatches}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:ColorSwatchChoice">
                    <Button Classes="small" Width="38" Height="24" Padding="3" Margin="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Command="{Binding $parent[ItemsControl].((local:ColorSlotEditor)DataContext).SetColor}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}">
                      <Border Background="{Binding Brush}" BorderBrush="#60000000" BorderThickness="1" CornerRadius="2" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Name="MoreSlotColorsButton" Classes="small" HorizontalAlignment="Left" ToolTip.Tip="Pick any colour"
                      Command="{Binding PickCustomColor}" CommandParameter="{Binding $self}">More Colors…</Button>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding CanHaveFabric}">
              <TextBlock Text="{Binding PatternTitle}" FontSize="11" FontWeight="SemiBold" />

              <!-- Hair: the dyes come first; the clothing patterns and tiles are behind "More patterns". -->
              <ItemsControl Name="DyeGallery" ItemsSource="{Binding DyeChoices}" IsVisible="{Binding IsHairKey}" ItemTemplate="{StaticResource DyeChoiceTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <Expander Name="MorePatterns" Header="More patterns" FontSize="11" IsVisible="{Binding IsHairKey}" IsExpanded="{Binding HasClothingPattern, Mode=OneWay}">
                <ItemsControl ItemsSource="{Binding MorePatternChoices}" ItemTemplate="{StaticResource PatternChoiceTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </Expander>

              <!-- Clothes: the patterns. -->
              <ItemsControl ItemsSource="{Binding PatternChoices}" IsVisible="{Binding !IsHairKey}" ItemTemplate="{StaticResource PatternChoiceTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <StackPanel Spacing="4" IsVisible="{Binding HasPattern}">
                <!-- A rainbow: one small swatch per band - click one, then pick its colour below. -->
                <ItemsControl Name="RainbowBandSwatches" ItemsSource="{Binding RainbowBands}" IsVisible="{Binding IsRainbow}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:RainbowBand">
                      <Button Classes="small choice" Classes.worn="{Binding IsSelected}" Width="36" Height="24" Padding="3"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                              Command="{Binding $parent[ItemsControl].((local:ColorSlotEditor)DataContext).SelectBand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Tip}">
                        <Border Background="{Binding Brush}" BorderBrush="#60000000" BorderThickness="1" CornerRadius="1" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Click a band, then pick its colour" FontSize="10" Opacity="0.7" IsVisible="{Binding IsRainbow}" />
                <StackPanel Spacing="4">
                  <ItemsControl ItemsSource="{Binding PatternSwatches}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:ColorSwatchChoice">
                        <Button Classes="small" Width="19" Height="16" Padding="2" Margin="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Command="{Binding $parent[ItemsControl].((local:ColorSlotEditor)DataContext).SetPatternColor}" CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding Name, StringFormat='Pattern in {0}'}">
                          <Border Background="{Binding Brush}" BorderBrush="#60000000" BorderThickness="1" CornerRadius="1" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Name="MorePatternColorsButton" Classes="small" HorizontalAlignment="Left" ToolTip.Tip="Pick any colour"
                          Command="{Binding PickCustomPatternColor}" CommandParameter="{Binding $self}">More Colors…</Button>
                </StackPanel>
                <Grid ColumnDefinitions="54,*" RowDefinitions="22" ColumnSpacing="4" IsVisible="{Binding HasDyeAmount}">
                  <TextBlock Text="{Binding DyeAmountLabel}" FontSize="11" VerticalAlignment="Center" />
                  <Slider Name="DyeAmountSlider" Grid.Column="1" Classes="body" Width="250" Minimum="5" Maximum="95" Value="{Binding DyeAmount}" local:DragGesture.Target="{Binding}"
                          ToolTip.Tip="{Binding DyeAmountTip}" />
                </Grid>
                <Grid ColumnDefinitions="54,*" RowDefinitions="22,22" ColumnSpacing="4" IsVisible="{Binding HasClothingPattern}">
                  <TextBlock Text="Size" FontSize="11" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Classes="body" Width="250" Minimum="1" Maximum="25" Value="{Binding PatternSize}" local:DragGesture.Target="{Binding}"
                          ToolTip.Tip="One repeat, as a share of the character's height" />
                  <TextBlock Grid.Row="1" Text="Angle" FontSize="11" VerticalAlignment="Center" />
                  <Slider Grid.Row="1" Grid.Column="1" Classes="body" Width="250" Minimum="0" Maximum="180" Value="{Binding PatternAngle}" local:DragGesture.Target="{Binding}" />
                </Grid>
              </StackPanel>

              <TextBlock Text="Texture" FontSize="11" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding TextureChoices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:FabricChoice">
                    <Button Classes="small choice" Classes.worn="{Binding IsCurrent}" Width="40" Height="46" Padding="2" Margin="1"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Command="{Binding $parent[ItemsControl].((local:ColorSlotEditor)DataContext).SetTexture}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Label}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" FontSize="8" HorizontalAlignment="Center" />
                        <Panel>
                          <local:FabricSwatch Color="{Binding Ground}" Fabric="{Binding Preview}" Tiles="{Binding Tiles}" IsVisible="{Binding !IsCustom}" />
                          <TextBlock Text="+" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsCustom}" />
                        </Panel>
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="54,*" RowDefinitions="22" ColumnSpacing="4" IsVisible="{Binding HasTexture}">
                <TextBlock Text="Strength" FontSize="11" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Classes="body" Width="250" Minimum="0" Maximum="100" Value="{Binding TextureStrength}" local:DragGesture.Target="{Binding}" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Flyout>
      </DropDownButton.Flyout>
    </DropDownButton>
</UserControl>
