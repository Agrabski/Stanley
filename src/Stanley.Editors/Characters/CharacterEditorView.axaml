<!--
  The character editor pane: the character standing on a height grid, with the comic's
  other characters faded beside it for comparison, and a status bar with the Front/Side
  switch (always to hand, whichever ribbon tab is open). Its other controls are on
  CharacterEditorRibbon, in the window's ribbon bar.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.CharacterEditorView"
             x:DataType="local:CharacterEditorViewModel">
  <UserControl.Styles>
    <!-- The status bar's view switch: shorter than a ribbon's small button, so the bar stays thin. -->
    <Style Selector=":is(Button).small.statusView">
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style Selector=":is(Button).small.statusView PathIcon">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0">
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Padding="24,16">
        <local:CharacterFigure Name="Stage" Character="{Binding LookWorking}" LineUp="{Binding ShownLineUp}" ShowGuides="True" Angle="{Binding PreviewAngle}"
                               Pose="{Binding StagePose}" Highlight="{Binding SelectedStickerId}" />
      </Border>
      <!-- Two small notes about the hair, over the foot of the stage like the export note over the page; neither is ever a dialog. -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,12" Spacing="6">
        <!-- After a hairstyle click threw away your own mix. Any other edit, or leaving the editor, takes it down. -->
        <Border Name="HairReplacedBar" Classes="toast" Padding="10,5" IsVisible="{Binding HasHairReplaced}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Name="HairReplacedText" Text="{Binding HairReplacedText}" FontSize="12" VerticalAlignment="Center" />
            <Button Name="AddToMixButton" Classes="small" Command="{Binding AddToMixCommand}"
                    ToolTip.Tip="Undo that and put the hairstyle's pieces on over your mix instead">Add to my mix instead</Button>
            <Button Name="DismissHairReplacedButton" Classes="small" Command="{Binding DismissHairReplacedCommand}" ToolTip.Tip="Close">
              <PathIcon Data="{StaticResource CloseIcon}" Width="10" Height="10" />
            </Button>
          </StackPanel>
        </Border>
        <!-- The character wears an old whole-hairstyle sticker that pieces now replace. -->
        <Border Name="HairUpgradeBar" Classes="toast" Padding="10,5" IsVisible="{Binding HasHairUpgrade}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Name="HairUpgradeText" Text="{Binding HairUpgradeText}" FontSize="12" VerticalAlignment="Center" />
            <Button Name="SwitchHairButton" Classes="small" Command="{Binding SwitchHairCommand}"
                    ToolTip.Tip="Change to the hairstyle made of pieces - the colours stay, in every look">Switch</Button>
            <Button Name="KeepHairButton" Classes="small" Command="{Binding KeepHairCommand}"
                    ToolTip.Tip="Keep the old hairstyle, and don't ask again for this character">Keep</Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Classes="ribbon" BorderThickness="0,1,0,0" Padding="10,1">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Name="HintText" Text="{Binding Hint}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding HeightText}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
        <!-- The view switch, like Word's view buttons: in the status bar so it's there whichever ribbon tab is open. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1" Margin="12,0,0,0">
          <RadioButton Name="StatusFrontButton" Classes="small statusView" GroupName="StatusPreviewAngle" Theme="{StaticResource {x:Type ToggleButton}}"
                       IsChecked="{Binding IsFrontPreview}" ToolTip.Tip="Look at the character from the front">
            <StackPanel Orientation="Horizontal" Spacing="4"><PathIcon Data="{StaticResource CharacterIcon}" /><TextBlock Text="Front" /></StackPanel>
          </RadioButton>
          <RadioButton Name="StatusSideButton" Classes="small statusView" GroupName="StatusPreviewAngle" Theme="{StaticResource {x:Type ToggleButton}}"
                       IsChecked="{Binding IsSidePreview}" ToolTip.Tip="Look at the character from the side - the same body, seen side on">
            <StackPanel Orientation="Horizontal" Spacing="4"><PathIcon Data="{StaticResource SideViewIcon}" /><TextBlock Text="Side" /></StackPanel>
          </RadioButton>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
