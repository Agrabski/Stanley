<!--
  The character editor's ribbon: the Body tab - body-type gallery, the five body
  sliders, skin colour, name, the line-up toggle and Close (back to the page); the Look
  tab - what the character wears (a gallery per slot - hair and face, clothes,
  accessories - previewed on the character) and
  the colours of the slots in use; and the contextual Sticker tab for the worn sticker
  picked on the stage (with its styles, when it has some). Shown in the window's ribbon bar whenever a character editor is
  the active pane.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.CharacterEditorRibbon"
             x:DataType="local:CharacterEditorViewModel">
  <UserControl.Resources>
    <!-- A slot's choices, each previewed on the character (hair, face and hats as close-ups). -->
    <DataTemplate x:Key="StickerChoicesTemplate" x:DataType="local:SlotGallery">
      <DockPanel MaxWidth="440">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="1,6,1,0">
        <Button Name="DrawYourOwnButton" Classes="small" Command="{Binding Draw}" CommandParameter="{Binding Info.Name}"
                ToolTip.Tip="Draw one in your own SVG editor (Inkscape...), on a template of this body - every save updates it here">Draw your own...</Button>
        <Button Name="ImportArtButton" Classes="small" Command="{Binding Import}" CommandParameter="{Binding Info.Name}"
                ToolTip.Tip="An SVG or PNG: a file drawn on a template goes where it was drawn; anything else is placed here to move and size">Import...</Button>
        <!-- Prints only: your own words (emoji too) on the clothes - put on as HELLO, then typed over on the Sticker tab. -->
        <Button Name="WearTextButton" Classes="small" Command="{Binding WearText}" CommandParameter="HELLO" IsVisible="{Binding WearText, Converter={x:Static ObjectConverters.IsNotNull}}"
                ToolTip.Tip="Put your own words on the clothes - emoji too; type them on the Sticker tab">Text</Button>
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Choices}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:StickerChoice">
            <Button Classes="small choice sticker" Classes.worn="{Binding IsWorn}" Classes.closeup="{Binding Closeup}" Margin="1" Padding="2"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Command="{Binding $parent[ItemsControl].((local:SlotGallery)DataContext).Wear}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Tip}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" FontSize="9" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <local:CharacterFigure Character="{Binding Preview}" Pose="{Binding Pose}" Closeup="{Binding Closeup}" />
              </DockPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </DockPanel>
    </DataTemplate>

    <!-- The Hairstyles tab of the Hair flyout: bald, the hairstyles, then the character's own whole hairstyles - each a close-up on this character. -->
    <DataTemplate x:Key="HairstyleChoicesTemplate" x:DataType="local:HairstyleGallery">
      <DockPanel MaxWidth="440">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="1,6,1,0">
        <Button Name="DrawYourOwnButton" Classes="small" Command="{Binding Draw}" CommandParameter="hair"
                ToolTip.Tip="Draw a whole hairstyle in your own SVG editor (Inkscape...), on a template of this body - every save updates it here">Draw your own...</Button>
        <Button Name="ImportArtButton" Classes="small" Command="{Binding Import}" CommandParameter="hair"
                ToolTip.Tip="An SVG or PNG of a whole hairstyle: a file drawn on a template goes where it was drawn; anything else is placed here to move and size">Import...</Button>
      </StackPanel>
      <ItemsControl Name="HairstyleChoices" ItemsSource="{Binding Choices}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:HairstyleChoice">
            <Button Classes="small choice sticker closeup" Classes.worn="{Binding IsWorn}" Margin="1" Padding="2"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Command="{Binding $parent[ItemsControl].((local:HairstyleGallery)DataContext).Wear}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Tip}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" FontSize="9" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <local:CharacterFigure Character="{Binding Preview}" Pose="{Binding Pose}" Closeup="{Binding Closeup}" />
              </DockPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </DockPanel>
    </DataTemplate>

    <!-- A slot's gallery: its label and what's worn, opening the choices. -->
    <DataTemplate x:Key="SlotGalleryTemplate" x:DataType="local:SlotGallery">
      <DropDownButton Classes="slotGallery" ToolTip.Tip="{Binding Tip}">
        <StackPanel Spacing="1">
          <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Current}" FontSize="9" Opacity="0.7" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="64" />
        </StackPanel>
        <DropDownButton.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StickerChoicesTemplate}" />
          </Flyout>
        </DropDownButton.Flyout>
      </DropDownButton>
    </DataTemplate>

    <!-- The same, half height, two to a row: for the face and accessories. -->
    <DataTemplate x:Key="CompactSlotGalleryTemplate" x:DataType="local:SlotGallery">
      <DropDownButton Classes="slotGallery compact" ToolTip.Tip="{Binding Tip}">
        <StackPanel Spacing="0">
          <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Current}" FontSize="9" Opacity="0.7" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="56" />
        </StackPanel>
        <DropDownButton.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StickerChoicesTemplate}" />
          </Flyout>
        </DropDownButton.Flyout>
      </DropDownButton>
    </DataTemplate>
  </UserControl.Resources>

  <TabControl Name="Tabs" Classes="ribbonTabs">
    <TabControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Margin="64,0,0,0" />
      </ItemsPanelTemplate>
    </TabControl.ItemsPanel>

    <TabItem Name="BodyTab" Classes="contextual character">
      <TabItem.Header><TextBlock Classes="characterHeader" Text="Body" /></TabItem.Header>
      <StackPanel Classes="tabContent">
        <DockPanel Classes="group">
          <ItemsControl Name="PresetGallery" ItemsSource="{Binding Presets}" Height="72">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:BodyPresetChoice">
                <Button Classes="small" Width="44" Height="72" Padding="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Command="{Binding $parent[ItemsControl].((local:CharacterEditorViewModel)DataContext).ApplyPresetCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="{Binding Name, StringFormat='{}{0} body - fine-tune with the sliders'}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="9" HorizontalAlignment="Center" />
                    <local:CharacterFigure Character="{Binding Preview}" />
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="groupLabel" Text="Body type" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Grid ColumnDefinitions="Auto,Auto,48" RowDefinitions="24,24,24" ColumnSpacing="6">
              <TextBlock Text="Height" FontSize="12" VerticalAlignment="Center" />
              <Slider Name="HeightSlider" Grid.Column="1" Classes="body" Minimum="{Binding MinHeightPercent}" Maximum="{Binding MaxHeightPercent}"
                      Value="{Binding HeightPercent}" ToolTip.Tip="How tall, relative to an average adult (100%)" />
              <TextBlock Grid.Column="2" Text="{Binding HeightText}" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Text="Weight" FontSize="12" VerticalAlignment="Center" />
              <Slider Name="WeightSlider" Grid.Row="1" Grid.Column="1" Classes="body" Minimum="0" Maximum="100"
                      Value="{Binding Weight}" ToolTip.Tip="Slim to heavy" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Weight, StringFormat='{}{0:0}'}" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Grid.Row="2" Text="Muscle" FontSize="12" VerticalAlignment="Center" />
              <Slider Name="MuscleSlider" Grid.Row="2" Grid.Column="1" Classes="body" Minimum="0" Maximum="100"
                      Value="{Binding Muscle}" ToolTip.Tip="Soft to muscular - shoulders, arms, chest and thighs" />
              <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Muscle, StringFormat='{}{0:0}'}" FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="Auto,Auto,58" RowDefinitions="24,24,24" ColumnSpacing="6">
              <TextBlock Text="Head size" FontSize="12" VerticalAlignment="Center" />
              <Slider Name="HeadSlider" Grid.Column="1" Classes="body" Minimum="{Binding MinHeadsTall}" Maximum="{Binding MaxHeadsTall}" IsDirectionReversed="True"
                      Value="{Binding HeadsTall}" ToolTip.Tip="Big head (chibi, child) to small head (heroic) - measured in heads tall" />
              <TextBlock Grid.Column="2" Text="{Binding HeadsTallText}" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Text="Shape" FontSize="12" VerticalAlignment="Center" />
              <Slider Name="FrameSlider" Grid.Row="1" Grid.Column="1" Classes="body" Minimum="0" Maximum="100"
                      Value="{Binding Frame}" ToolTip.Tip="Broad shoulders (left) to wide hips (right)" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Frame, StringFormat='{}{0:0}'}" FontSize="12" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Proportions" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <Grid ColumnDefinitions="Auto,Auto">
            <ItemsControl Name="SkinSwatches" ItemsSource="{Binding SkinSwatches}" Width="90">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:SkinSwatch">
                  <Button Classes="small" Width="26" Height="22" Padding="3" Margin="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                          Command="{Binding $parent[ItemsControl].((local:CharacterEditorViewModel)DataContext).SetSkinCommand}"
                          CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}">
                    <Border Background="{Binding Brush}" BorderBrush="#60000000" BorderThickness="1" CornerRadius="2" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Any colour at all: Word's "More Colors…", beside the swatches so it fits the ribbon's height. -->
            <Button Grid.Column="1" Name="MoreSkinColorsButton" Classes="small" Height="70" Padding="4,2" Margin="2,1,0,0" VerticalAlignment="Top"
                    ToolTip.Tip="More Colors… - pick any skin colour" Command="{Binding PickCustomSkinColorCommand}" CommandParameter="{Binding $self}">
              <StackPanel Spacing="4">
                <UniformGrid Rows="2" Columns="2" Width="14" Height="14" HorizontalAlignment="Center">
                  <Border Background="#ed7d31" />
                  <Border Background="#ffc000" />
                  <Border Background="#4472c4" />
                  <Border Background="#70ad47" />
                </UniformGrid>
                <TextBlock Text="More…" FontSize="11" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock Classes="groupLabel" Text="Skin" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <StackPanel Spacing="6" Margin="0,4,0,0">
            <TextBox Name="NameBox" Width="150" Height="26" FontSize="12" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                     ToolTip.Tip="The character's name (Enter to apply)" />
            <CheckBox Name="LineUpCheck" IsChecked="{Binding ShowLineUp}" Focusable="False" FontSize="12" Content="Compare with others" />
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Character" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <RadioButton Name="FrontPreviewButton" Classes="tool" GroupName="PreviewAngle" Theme="{StaticResource {x:Type ToggleButton}}"
                         IsChecked="{Binding IsFrontPreview}" ToolTip.Tip="Look at the character from the front">
              <StackPanel><PathIcon Data="{StaticResource CharacterIcon}" /><TextBlock Text="Front" /></StackPanel>
            </RadioButton>
            <RadioButton Name="SidePreviewButton" Classes="tool" GroupName="PreviewAngle" Theme="{StaticResource {x:Type ToggleButton}}"
                         IsChecked="{Binding IsSidePreview}" ToolTip.Tip="Look at the character from the side - the same body, seen side on">
              <StackPanel><PathIcon Data="{StaticResource SideViewIcon}" /><TextBlock Text="Side" /></StackPanel>
            </RadioButton>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="View" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <Button Name="BackToPageButton" Classes="tool" Command="{Binding BackToPageCommand}" ToolTip.Tip="Back to the page (the Pages pane works too)">
            <StackPanel><PathIcon Data="{StaticResource CloseIcon}" /><TextBlock Text="Close" /></StackPanel>
          </Button>
          <TextBlock Classes="groupLabel" Text="Back to page" />
        </DockPanel>
      </StackPanel>
    </TabItem>

    <TabItem Name="LookTab" Classes="contextual character">
      <TabItem.Header><TextBlock Classes="characterHeader" Text="Look" /></TabItem.Header>
      <StackPanel Classes="tabContent">
        <DockPanel Classes="group">
          <DropDownButton Name="LookPicker" Classes="slotGallery" ToolTip.Tip="Named looks - winter clothes, after the haircut... Everything on this tab changes the look shown here">
            <StackPanel Spacing="1">
              <TextBlock Text="Look" FontSize="12" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding CurrentLookName}" FontSize="9" Opacity="0.7" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="64" />
            </StackPanel>
            <DropDownButton.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Spacing="6" MaxWidth="440">
                  <ItemsControl Name="LookItems" ItemsSource="{Binding Looks}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:LookItem">
                        <Button Classes="small choice sticker" Classes.worn="{Binding IsCurrent}" Margin="1" Padding="2"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Command="{Binding $parent[ItemsControl].((local:CharacterEditorViewModel)DataContext).ShowLookCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="9" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <local:CharacterFigure Character="{Binding Preview}" />
                          </DockPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Name="NewLookButton" Classes="small" Command="{Binding NewLookCommand}"
                            ToolTip.Tip="A new look, starting as a copy of this one">New look</Button>
                    <TextBox Name="LookNameBox" Width="150" FontSize="12" Text="{Binding CurrentLookName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding IsNamedLook}" ToolTip.Tip="The look's name" />
                    <Button Name="DeleteLookButton" Classes="small" Command="{Binding DeleteLookCommand}" ToolTip.Tip="{Binding DeleteLookTip}">Delete</Button>
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <TextBlock Classes="groupLabel" Text="Look" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <StackPanel Orientation="Vertical" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <!-- The one Hair button: its flyout has a row of tabs - Hairstyles first, then a tab per piece and Streaks - and that tab's choices under them. -->
            <DropDownButton Name="HairButton" Classes="slotGallery" ToolTip.Tip="{Binding HairTip}">
              <StackPanel Spacing="1">
                <TextBlock Text="Hair" FontSize="12" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding HairCurrent}" FontSize="9" Opacity="0.7" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="64" />
              </StackPanel>
              <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Spacing="6" MaxWidth="440">
                    <ItemsControl Name="HairTabItems" ItemsSource="{Binding HairTabs}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:HairTab">
                          <Button Classes="small choice" Classes.worn="{Binding IsCurrent}" Margin="1" Padding="8,2"
                                  Command="{Binding $parent[ItemsControl].((local:CharacterEditorViewModel)DataContext).ShowHairTabCommand}"
                                  CommandParameter="{Binding}" Content="{Binding Label}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Only the tab in view is built: previews are expensive. -->
                    <ContentControl Name="HairTabContentHost" Content="{Binding HairTabContent}">
                      <ContentControl.DataTemplates>
                        <DataTemplate DataType="local:HairstyleGallery" x:DataType="local:HairstyleGallery">
                          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HairstyleChoicesTemplate}" />
                        </DataTemplate>
                        <DataTemplate DataType="local:SlotGallery" x:DataType="local:SlotGallery">
                          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StickerChoicesTemplate}" />
                        </DataTemplate>
                      </ContentControl.DataTemplates>
                    </ContentControl>
                  </StackPanel>
                </Flyout>
              </DropDownButton.Flyout>
            </DropDownButton>
            <ItemsControl Name="FaceGalleries" ItemsSource="{Binding FaceGalleries}" ItemTemplate="{StaticResource CompactSlotGalleryTemplate}" Width="148">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <DropDownButton Name="PreviewExpressionButton" Classes="slotGallery" ToolTip.Tip="See the face in another expression while you pick - a preview only; expressions are set per panel">
              <StackPanel Spacing="1">
                <TextBlock Text="Preview" FontSize="12" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PreviewExpression.Name}" FontSize="9" Opacity="0.7" HorizontalAlignment="Center" />
              </StackPanel>
              <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <ItemsControl ItemsSource="{Binding PreviewExpressionChoices}" MaxWidth="320">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:ExpressionPresetChoice">
                        <Button Classes="small choice sticker closeup" Classes.worn="{Binding IsCurrent}" Margin="1" Padding="2"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Command="{Binding $parent[ItemsControl].((local:CharacterEditorViewModel)DataContext).PreviewExpressionCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="9" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <local:CharacterFigure Character="{Binding Character}" Pose="{Binding Pose}" Closeup="True" />
                          </DockPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Flyout>
              </DropDownButton.Flyout>
            </DropDownButton>
          </StackPanel>
          <CheckBox Name="SplitEyesCheck" IsChecked="{Binding IsEyesSplit}" IsEnabled="{Binding CanSplitEyes}" Focusable="False" FontSize="10"
                    ToolTip.Tip="Set the eyes' shape, colour and expression separately for left and right">Different left/right eyes</CheckBox>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsEyesSplit}">
            <StackPanel Spacing="1" Width="72">
              <TextBlock Text="Left eye" FontSize="9" Opacity="0.7" />
              <ComboBox ItemsSource="{Binding EyeExpressionOptions}" SelectedValue="{Binding PreviewLeftEye}" SelectedValueBinding="{Binding Value}"
                        DisplayMemberBinding="{Binding Label}" FontSize="10" Padding="4,2" HorizontalAlignment="Stretch"
                        ToolTip.Tip="Preview the left eye's own expression - a preview only; expressions are set per panel" />
            </StackPanel>
            <StackPanel Spacing="1" Width="72">
              <TextBlock Text="Right eye" FontSize="9" Opacity="0.7" />
              <ComboBox ItemsSource="{Binding EyeExpressionOptions}" SelectedValue="{Binding PreviewRightEye}" SelectedValueBinding="{Binding Value}"
                        DisplayMemberBinding="{Binding Label}" FontSize="10" Padding="4,2" HorizontalAlignment="Stretch"
                        ToolTip.Tip="Preview the right eye's own expression - a preview only; expressions are set per panel" />
            </StackPanel>
          </StackPanel>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Hair &amp; face" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <ItemsControl Name="ClothesGalleries" ItemsSource="{Binding ClothesGalleries}" ItemTemplate="{StaticResource SlotGalleryTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBlock Classes="groupLabel" Text="Clothes" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <ItemsControl Name="AccessoryGalleries" ItemsSource="{Binding AccessoryGalleries}" ItemTemplate="{StaticResource CompactSlotGalleryTemplate}" Width="148">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBlock Classes="groupLabel" Text="Accessories" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <DockPanel Classes="group">
          <ItemsControl Name="ColorEditors" ItemsSource="{Binding ColorEditors}" MaxWidth="330">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:ColorSlotEditor">
                <local:ColorSlotDropdown />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="groupLabel" Text="Colours" />
        </DockPanel>
      </StackPanel>
    </TabItem>

    <TabItem Name="StickerTab" Classes="contextual sticker" IsVisible="{Binding HasSelectedSticker}">
      <TabItem.Header><TextBlock Classes="stickerHeader" Text="Sticker" /></TabItem.Header>
      <StackPanel Classes="tabContent">
        <DockPanel Classes="group">
          <StackPanel Spacing="6" Margin="0,4,0,0">
            <ComboBox Name="WornPicker" Width="170" FontSize="12" ItemsSource="{Binding WornStickers}" SelectedItem="{Binding SelectedWorn}"
                      ToolTip.Tip="What you're working on - or click it on the character" />
            <Button Name="DeselectStickerButton" Classes="small" Command="{Binding DeselectStickerCommand}" HorizontalAlignment="Left">Done</Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="{Binding SelectedStickerName}" />
        </DockPanel>
        <Rectangle Classes="divider" />

        <!-- Ways to wear it - a hood up or down, a cap's brim forward, back or to a side - each previewed on the character (not for faces: their variants are expressions). -->
        <DockPanel Classes="group" IsVisible="{Binding HasSelectedStickerStyles}">
          <ItemsControl Name="StyleGallery" ItemsSource="{Binding SelectedStickerStyles}" Height="72">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:StickerStyleChoice">
                <Button Classes="small choice" Classes.worn="{Binding IsCurrent}" Width="56" Height="72" Padding="2"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Command="{Binding $parent[ItemsControl].((local:CharacterEditorViewModel)DataContext).SetStyleCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="{Binding Tip}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" FontSize="9" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <local:CharacterFigure Character="{Binding Preview}" Pose="{Binding Pose}" Angle="{Binding Angle}" Closeup="{Binding Closeup}" />
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="groupLabel" Text="Worn" ToolTip.Tip="How it's worn - kept with the look you're editing; right-click it on a page for one panel only" />
        </DockPanel>
        <Rectangle Classes="divider" IsVisible="{Binding HasSelectedStickerStyles}" />

        <!-- Hair (a whole hairstyle, a piece or a streak): its colour and dye - a piece follows the Hair colour until it's given its own here -
             and whether it paints over glasses. -->
        <DockPanel Classes="group" IsVisible="{Binding HasSelectedHairColor}">
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
            <StackPanel Spacing="2">
              <ContentControl Name="StickerColor" Content="{Binding SelectedColorEditor}" HorizontalAlignment="Left">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="local:ColorSlotEditor">
                    <local:ColorSlotDropdown />
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
              <CheckBox Name="OverGlassesBox" IsChecked="{Binding SelectedOverGlasses}" IsVisible="{Binding CanSetOverGlasses}" FontSize="12"
                        ToolTip.Tip="Paint it over glasses too - a long fringe over one eye covers that lens">Over glasses</CheckBox>
            </StackPanel>
            <StackPanel Spacing="2" MaxWidth="170" IsVisible="{Binding CanFollowHair}">
              <Button Name="SameAsHairButton" Classes="small" Command="{Binding SameAsHairCommand}" HorizontalAlignment="Left"
                      ToolTip.Tip="Drop its own colour and dye, so it follows the Hair colour again">Same as hair</Button>
              <TextBlock Name="SameAsHairNote" Text="{Binding SameAsHairNote}" IsVisible="{Binding HasSameAsHairNote}" FontSize="9" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Hair" />
        </DockPanel>
        <Rectangle Classes="divider" IsVisible="{Binding HasSelectedHairColor}" />

        <DockPanel Classes="group" IsVisible="{Binding HasArtParts}">
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6">
              <TextBlock Text="Size" FontSize="12" VerticalAlignment="Center" />
              <Slider Name="ArtScaleSlider" Grid.Column="1" Classes="body" Minimum="10" Maximum="300" Value="{Binding SelectedArtScale}"
                      ToolTip.Tip="How big it is, compared with how it was drawn" />
              <TextBlock Grid.Column="2" Text="{Binding SelectedArtScale, StringFormat='{}{0:0}%'}" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Text="Turn" FontSize="12" VerticalAlignment="Center" />
              <Slider Name="ArtTurnSlider" Grid.Row="1" Grid.Column="1" Classes="body" Minimum="-180" Maximum="180" Value="{Binding SelectedArtRotation}"
                      ToolTip.Tip="Turn it" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedArtRotation, StringFormat='{}{0:0}°'}" FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasDrawnArt}">
              <CheckBox Name="HugShapeBox" IsChecked="{Binding SelectedHugsShape}" FontSize="12"
                        ToolTip.Tip="Bend with the body (hair, prints) instead of keeping its own shape (eyes, logos)">Hug the shape</CheckBox>
              <Button Name="EditArtButton" Classes="small" Command="{Binding EditSelectedArtCommand}"
                      ToolTip.Tip="Open this view of it in your SVG editor - saves come back here">Edit drawing...</Button>
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Art" ToolTip.Tip="Drag it on the character to move it" />
        </DockPanel>
        <Rectangle Classes="divider" IsVisible="{Binding HasArtParts}" />

        <!-- A text print: what it says (Enter or leaving the box applies it), bold or not, and a few emoji a click away. -->
        <DockPanel Classes="group" IsVisible="{Binding SelectedIsTextPrint}">
          <StackPanel Spacing="4" Margin="0,2,0,0">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBox Name="PrintTextBox" Width="170" FontSize="12" Text="{Binding SelectedText, UpdateSourceTrigger=LostFocus}"
                       ToolTip.Tip="What it says - emoji too (Enter to apply)" />
              <ToggleButton Name="PrintBoldButton" Classes="small" IsChecked="{Binding SelectedTextBold}" FontWeight="Bold" ToolTip.Tip="Bold">B</ToggleButton>
            </StackPanel>
            <ItemsControl Name="PrintEmoji" ItemsSource="{Binding CommonEmoji}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button Classes="small" Padding="2,0" Content="{Binding}" FontSize="15" FontFamily="Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji" ToolTip.Tip="Add it to the text"
                          Command="{Binding $parent[ItemsControl].((local:CharacterEditorViewModel)DataContext).InsertEmojiCommand}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Text" />
        </DockPanel>
        <Rectangle Classes="divider" IsVisible="{Binding SelectedIsTextPrint}" />
        <DockPanel Classes="group" IsVisible="{Binding HasFit}">
          <Grid ColumnDefinitions="Auto,Auto,34" RowDefinitions="24,24,24" ColumnSpacing="6">
            <TextBlock Text="Length" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding HasLength}" />
            <Slider Name="LengthSlider" Grid.Column="1" Classes="body" Minimum="0" Maximum="100" Value="{Binding SelectedLength}" IsVisible="{Binding HasLength}"
                    ToolTip.Tip="How far down it reaches: crop top to long, shorts to trousers, mini to maxi" />
            <TextBlock Grid.Column="2" Text="{Binding SelectedLength, StringFormat='{}{0:0}'}" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding HasLength}" />
            <TextBlock Grid.Row="1" Text="Sleeves" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding HasSleeves}" />
            <Slider Name="SleevesSlider" Grid.Row="1" Grid.Column="1" Classes="body" Minimum="0" Maximum="100" Value="{Binding SelectedSleeves}" IsVisible="{Binding HasSleeves}"
                    ToolTip.Tip="How far down the arm the sleeves reach" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedSleeves, StringFormat='{}{0:0}'}" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding HasSleeves}" />
            <TextBlock Grid.Row="2" Text="Fit" FontSize="12" VerticalAlignment="Center" />
            <Slider Name="FitSlider" Grid.Row="2" Grid.Column="1" Classes="body" Minimum="0" Maximum="50" Value="{Binding SelectedFit}"
                    ToolTip.Tip="Skin tight to baggy" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedFit, StringFormat='{}{0:0}'}" FontSize="12" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="groupLabel" Text="Fit" />
        </DockPanel>
        <Rectangle Classes="divider" IsVisible="{Binding HasFit}" />

        <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <Button Name="StickerUpButton" Classes="small" Command="{Binding MoveSelectedUpCommand}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Over the next one in the same slot">Forward</Button>
              <Button Name="StickerDownButton" Classes="small" Command="{Binding MoveSelectedDownCommand}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Under the previous one in the same slot">Back</Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Spacing="1" Margin="6,0,0,0">
              <Button Name="TakeOffButton" Classes="small" Command="{Binding TakeOffSelectedCommand}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Stop wearing it - it stays in the wardrobe">Take off</Button>
              <Button Name="RemoveStickerButton" Classes="small" Command="{Binding RemoveSelectedCommand}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Out of the wardrobe altogether">Remove</Button>
            </StackPanel>
            <!-- Prints and badges only: as many of the same one as you like. -->
            <Button Name="DuplicateStickerButton" Classes="small" Command="{Binding DuplicateSelectedCommand}" IsVisible="{Binding CanDuplicateSelected}"
                    VerticalAlignment="Center" Margin="6,0,0,0" ToolTip.Tip="Another one just like it, a step aside - drag it where it goes">Duplicate</Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Wear" />
        </DockPanel>
      </StackPanel>
    </TabItem>
  </TabControl>
</UserControl>
