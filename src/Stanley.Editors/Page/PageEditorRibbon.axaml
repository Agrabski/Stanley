<!--
  The page editor's ribbon: Word-style tabs (Home / Insert / Layout / View) plus
  contextual tabs (Panel, Character, Bubble, Shape, Text) that appear only while that
  kind of thing is selected. Hosted by the window's ribbon bar whenever a page editor is the active pane,
  with that pane's PageEditorViewModel as DataContext. The window overlays its File
  button on the left end of the tab strip, which is why the strip starts indented.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             xmlns:bubbles="using:Stanley.ProjectModel.Bubbles"
             xmlns:characters="using:Stanley.ProjectModel.Characters"
             xmlns:objects="using:Stanley.ProjectModel.Objects"
             xmlns:editing="using:Stanley.Editing"
             x:Class="Stanley.Editors.PageEditorRibbon"
             x:DataType="local:PageEditorViewModel">
    <TabControl Name="Tabs" Classes="ribbonTabs">
        <TabControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Margin="64,0,0,0">
                </StackPanel>
            </ItemsPanelTemplate>
        </TabControl.ItemsPanel>

        <!-- ============================== HOME ============================== -->
        <TabItem Name="HomeTab" Header="Home">
            <local:HomeRibbonTab />
        </TabItem>

        <!-- ============================== INSERT ============================== -->
        <TabItem Name="InsertTab" Header="Insert">
            <local:InsertRibbonTab />
        </TabItem>

        <!-- ============================== LAYOUT ============================== -->
        <TabItem Name="LayoutTab" Header="Layout">
            <local:LayoutRibbonTab />
        </TabItem>

        <!-- ============================== VIEW ============================== -->
        <TabItem Name="ViewTab" Header="View">
            <local:ViewRibbonTab />
        </TabItem>

        <!-- ============================== PANEL (contextual) ============================== -->
        <TabItem Name="PanelTab" Classes="contextual panel" IsVisible="{Binding IsPanelContext}">
            <TabItem.Header>
                <TextBlock Classes="panelHeader" Text="Panel" />
            </TabItem.Header>
            <local:PanelRibbonTab />
        </TabItem>

        <!-- ============================== CHARACTER (contextual) ============================== -->
        <TabItem Name="CharacterTab" Classes="contextual character" IsVisible="{Binding IsCharacterContext}">
            <TabItem.Header>
                <TextBlock Classes="characterHeader" Text="Character" />
            </TabItem.Header>
            <local:CharacterRibbonTab />
        </TabItem>

        <!-- ============================== BUBBLE (contextual) ============================== -->
        <TabItem Name="BubbleTab" Classes="contextual bubble" IsVisible="{Binding IsBubbleContext}">
            <TabItem.Header>
                <TextBlock Classes="bubbleHeader" Text="Bubble" />
            </TabItem.Header>
            <local:BubbleRibbonTab />
        </TabItem>
        <!-- ============================== SHAPE (contextual) ============================== -->
        <TabItem Name="ShapeTab" Classes="contextual shape" IsVisible="{Binding IsShapeContext}">
            <TabItem.Header>
                <TextBlock Classes="shapeHeader" Text="Shape" />
            </TabItem.Header>
            <local:ShapeRibbonTab />
        </TabItem>

        <!-- ============================== PICTURE (contextual) ============================== -->
        <TabItem Name="PictureTab" Classes="contextual shape" IsVisible="{Binding IsPictureContext}">
            <TabItem.Header>
                <TextBlock Classes="shapeHeader" Text="Picture" />
            </TabItem.Header>
            <local:PictureRibbonTab />
        </TabItem>

        <!-- ============================== SPEED LINES (contextual) ============================== -->
        <TabItem Name="SpeedLinesTab" Classes="contextual shape" IsVisible="{Binding IsSpeedLinesContext}">
            <TabItem.Header>
                <TextBlock Classes="shapeHeader" Text="Speed Lines" />
            </TabItem.Header>
            <local:SpeedLinesRibbonTab />
        </TabItem>

        <!-- ============================== TEXT (contextual) ============================== -->
        <TabItem Name="TextTab" Classes="contextual lettering" IsVisible="{Binding IsTextContext}">
            <TabItem.Header>
                <TextBlock Classes="letteringHeader" Text="Text" />
            </TabItem.Header>
            <local:TextRibbonTab />
        </TabItem>
    </TabControl>
</UserControl>