<!--
  The page navigator pane (docked left): live page thumbnails, three to a row like a
  print-shop page sorter, each with its page number (or "Title") underneath.
  Click to go to a page, drag to reorder, right-click for page actions, Delete removes
  the selected page, "New page" at the bottom. Lives in the dock area, below the ribbon,
  and is not an editor - the ribbon keeps showing the page being edited.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.PageNavigatorView"
             x:DataType="local:PageNavigatorViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox#PageList ListBoxItem">
      <Setter Property="Padding" Value="5,6,5,4" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- The thumbnail's own blue frame marks the current page; the row itself only gets a faint tint. -->
    <Style Selector="ListBox#PageList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StanleySelectedTintBrush}" />
    </Style>
    <Style Selector="ListBox#PageList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StanleySelectedHoverTintBrush}" />
    </Style>
    <Style Selector="ListBox#PageList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StanleyHoverTintBrush}" />
    </Style>
    <Style Selector="Border.thumbFrame">
      <Setter Property="BorderBrush" Value="{DynamicResource StanleyThumbBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #30000000" />
    </Style>
    <Style Selector="ListBox#PageList ListBoxItem:selected Border.thumbFrame">
      <Setter Property="BorderBrush" Value="{DynamicResource StanleySelectionBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ListBox#PageList ListBoxItem:selected TextBlock.pageNumber">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource StanleySelectionBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
    <Border DockPanel.Dock="Bottom" Padding="8" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <Button Name="AddPageButton" Command="{Binding AddPageCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              ToolTip.Tip="Add a blank page after the current one">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14" />
          <TextBlock Text="New page" />
        </StackPanel>
      </Button>
    </Border>
    <Grid>
      <ListBox Name="PageList" ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage, Mode=OneWay}" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="4">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" VerticalAlignment="Top" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:PageItem">
            <StackPanel Spacing="3">
              <Border Classes="thumbFrame">
                <local:PageThumbnail Page="{Binding Editor}" />
              </Border>
              <TextBlock Classes="pageNumber" Text="{Binding Caption}" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Canvas IsHitTestVisible="False">
        <Border Name="DropIndicator" Width="3" CornerRadius="1.5" Background="{DynamicResource StanleySelectionBrush}" IsVisible="False" />
      </Canvas>
    </Grid>
  </DockPanel>
</UserControl>
