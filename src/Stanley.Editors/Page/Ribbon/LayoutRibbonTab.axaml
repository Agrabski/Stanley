<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             xmlns:bubbles="using:Stanley.ProjectModel.Bubbles"
             xmlns:characters="using:Stanley.ProjectModel.Characters"
             xmlns:objects="using:Stanley.ProjectModel.Objects"
             xmlns:editing="using:Stanley.Editing"
             x:Class="Stanley.Editors.LayoutRibbonTab"
             x:DataType="local:PageEditorViewModel">
  <StackPanel Classes="tabContent">
      <DockPanel Classes="group">
          <StackPanel Name="LayoutGallery" Orientation="Horizontal" Height="60" Spacing="2" />
          <TextBlock Classes="groupLabel" Text="Page layout" />
      </DockPanel>
      <Rectangle Classes="divider" />

      <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal" Spacing="8">
              <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="6"
                    VerticalAlignment="Center">
                  <TextBlock Text="Margin" FontSize="12" VerticalAlignment="Center" />
                  <NumericUpDown Name="MarginInput" Grid.Column="1" Minimum="0" Maximum="40" Increment="1"
                                 FormatString="0.# mm" Width="130" Height="26" FontSize="12"
                                 ToolTip.Tip="Distance from the page edge to the panels, for every page - panel edges on the margin move with it, and panels snap to it" />
                  <TextBlock Grid.Row="1" Text="Gutter" FontSize="12" VerticalAlignment="Center" />
                  <NumericUpDown Name="GutterInput" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="20"
                                 Increment="0.5" FormatString="0.# mm" Width="130" Height="26" FontSize="12"
                                 ToolTip.Tip="Space between neighbouring panels, for every page - new layouts and snapping use it" />
              </Grid>
              <ToggleButton Name="SnapButton" Classes="tool" IsChecked="{Binding SnapEnabled}"
                            ToolTip.Tip="Snap panel edges to the page margin and a gutter's width from other panels (hold Alt while dragging to place freely)">
                  <StackPanel>
                      <PathIcon
                          Data="M4,3 H9 V12 A3,3 0 0 0 15,12 V3 H20 V12 A8,8 0 0 1 4,12 Z M4,5 H9 V7 H4 Z M15,5 H20 V7 H15 Z" />
                      <TextBlock Text="Snap" />
                  </StackPanel>
              </ToggleButton>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Spacing" />
      </DockPanel>
      <Rectangle Classes="divider" />

      <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
              <Button Classes="tool" Command="{Binding SplitColumnsCommand}"
                      ToolTip.Tip="Split the selected panel into two side-by-side panels">
                  <StackPanel>
                      <PathIcon Data="{StaticResource ColumnsIcon}" /><TextBlock Text="Columns" />
                  </StackPanel>
              </Button>
              <Button Classes="tool" Command="{Binding SplitRowsCommand}"
                      ToolTip.Tip="Split the selected panel into two stacked panels">
                  <StackPanel>
                      <PathIcon Data="{StaticResource RowsIcon}" /><TextBlock Text="Rows" />
                  </StackPanel>
              </Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Split panel" />
      </DockPanel>
      <Rectangle Classes="divider" />

      <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
              <ToggleButton Name="LockLayoutButton" Classes="tool" IsChecked="{Binding IsLayoutLocked}"
                            ToolTip.Tip="Prevent panels on this page from being moved, resized, split, deleted or re-tiled - bubbles and characters are unaffected">
                  <StackPanel>
                      <PathIcon Data="{StaticResource LockIcon}" /><TextBlock Text="Lock layout" />
                  </StackPanel>
              </ToggleButton>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Protect" />
      </DockPanel>
      <Rectangle Classes="divider" IsVisible="{Binding HasPageNumbering}" />

      <!-- Word's Page Number menu: where (Top of page / Bottom of page), remove, and how the numbering runs. -->
      <DockPanel Classes="group" IsVisible="{Binding HasPageNumbering}">
          <DropDownButton Name="PageNumbersButton" Classes="slotGallery" Width="120"
                          ToolTip.Tip="Print page numbers on every page of the comic (not just this one)">
              <StackPanel Spacing="1">
                  <PathIcon Data="{StaticResource PageNumberIcon}" Width="20" Height="20" />
                  <TextBlock Text="Page numbers" FontSize="11" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding PageNumbersSummary}" FontSize="9" Opacity="0.7"
                             HorizontalAlignment="Center" />
              </StackPanel>
              <DropDownButton.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                      <MenuItem Name="TopOfPageMenu" Header="Top of page">
                          <MenuItem Name="TopOuterItem" Header="Outer corner" ToggleType="Radio"
                                    GroupName="PageNumberPosition"
                                    IsChecked="{Binding IsPageNumbersTopOuter, Mode=TwoWay}" />
                      </MenuItem>
                      <MenuItem Name="BottomOfPageMenu" Header="Bottom of page">
                          <MenuItem Name="BottomCenterItem" Header="Centre" ToggleType="Radio"
                                    GroupName="PageNumberPosition"
                                    IsChecked="{Binding IsPageNumbersBottomCenter, Mode=TwoWay}" />
                          <MenuItem Name="BottomOuterItem" Header="Outer corner" ToggleType="Radio"
                                    GroupName="PageNumberPosition"
                                    IsChecked="{Binding IsPageNumbersBottomOuter, Mode=TwoWay}" />
                      </MenuItem>
                      <MenuItem Name="RemovePageNumbersItem" Header="Remove page numbers"
                                Command="{Binding RemovePageNumbersCommand}" />
                      <Separator />
                      <MenuItem Name="NumberFirstPageItem" Header="Number the first page"
                                ToggleType="CheckBox" IsChecked="{Binding NumberFirstPage, Mode=TwoWay}"
                                IsEnabled="{Binding PageNumbersEnabled}"
                                ToolTip.Tip="Covers usually aren't numbered; the cover still counts as page 1" />
                      <MenuItem Name="StartAtMenu" Header="Start at" IsEnabled="{Binding PageNumbersEnabled}">
                          <MenuItem StaysOpenOnClick="True">
                              <MenuItem.Header>
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                      <TextBlock Text="First page is number" VerticalAlignment="Center" />
                                      <NumericUpDown Name="PageNumberStartInput" Minimum="0" Maximum="9999"
                                                     Increment="1" FormatString="0" Width="110" Height="26"
                                                     FontSize="12"
                                                     ToolTip.Tip="The number the first page would carry - to continue numbering from an earlier book" />
                                  </StackPanel>
                              </MenuItem.Header>
                          </MenuItem>
                      </MenuItem>
                  </MenuFlyout>
              </DropDownButton.Flyout>
          </DropDownButton>
          <TextBlock Classes="groupLabel" Text="Page" />
      </DockPanel>
  </StackPanel>
</UserControl>
