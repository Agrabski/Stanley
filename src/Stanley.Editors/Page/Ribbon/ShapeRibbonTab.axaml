<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             xmlns:bubbles="using:Stanley.ProjectModel.Bubbles"
             xmlns:characters="using:Stanley.ProjectModel.Characters"
             xmlns:objects="using:Stanley.ProjectModel.Objects"
             xmlns:editing="using:Stanley.Editing"
             x:Class="Stanley.Editors.ShapeRibbonTab"
             x:DataType="local:PageEditorViewModel">
  <StackPanel Classes="tabContent">
      <DockPanel Classes="group">
          <StackPanel Spacing="2" Margin="0,4,0,0">
              <local:ColorMenuButton Name="ShapeFillButton" Label="Shape Fill"
                                     Icon="{StaticResource ShapeFillIcon}" DefaultColor="#4472c4"
                                     Command="{Binding SetFillColorCommand}" NoneLabel="No Fill"
                                     MoreLabel="More Fill Colors…"
                                     CurrentColor="{Binding CurrentShapeStyle.Fill}"
                                     ToolTip.Tip="Shape Fill - the colour inside the shape (a closed one)" />
              <local:ColorMenuButton Name="ShapeOutlineButton" Label="Shape Outline"
                                     Icon="{StaticResource ShapeOutlineIcon}" DefaultColor="#000000"
                                     Command="{Binding SetStrokeColorCommand}" NoneLabel="No Outline"
                                     MoreLabel="More Outline Colors…"
                                     CurrentColor="{Binding CurrentShapeStyle.Stroke}"
                                     WeightCommand="{Binding SetStrokeWeightCommand}"
                                     CurrentWeight="{Binding CurrentShapeStyle.StrokeWidthMm}"
                                     DashCommand="{Binding SetStrokeDashCommand}"
                                     CurrentDash="{Binding CurrentShapeStyle.Dash}"
                                     ToolTip.Tip="Shape Outline - the line's colour, weight and dashes" />
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Shape Styles" />
      </DockPanel>
      <Rectangle Classes="divider" />
      <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
              <ToggleButton Name="EditPointsButton" Classes="tool" IsChecked="{Binding IsEditingPoints}"
                            IsEnabled="{Binding CanEditPoints}"
                            ToolTip.Tip="Edit Points - drag the shape's points to reshape it, drag its outline to add a point, drag a point's round handles to bend the curve, double-click a point to make it smooth or sharp"
                            local:Shortcut.Keys="Enter">
                  <StackPanel>
                      <PathIcon Data="{StaticResource EditPointsIcon}" /><TextBlock Text="Edit Points" />
                  </StackPanel>
              </ToggleButton>
              <StackPanel Spacing="1" VerticalAlignment="Center">
                  <RadioButton Name="SmoothPointButton" Classes="small" GroupName="PointKind"
                               Theme="{StaticResource {x:Type ToggleButton}}"
                               IsChecked="{Binding IsSelectedPointSmooth}" IsEnabled="{Binding HasSelectedPoint}"
                               ToolTip.Tip="Smooth point - the outline curves through it"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                      Smooth
                  </RadioButton>
                  <RadioButton Name="CornerPointButton" Classes="small" GroupName="PointKind"
                               Theme="{StaticResource {x:Type ToggleButton}}"
                               IsChecked="{Binding IsSelectedPointCorner}" IsEnabled="{Binding HasSelectedPoint}"
                               ToolTip.Tip="Corner point - the outline turns sharply there"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                      Corner
                  </RadioButton>
                  <Button Name="DeletePointButton" Classes="small" Command="{Binding DeletePointCommand}"
                          ToolTip.Tip="Delete the selected point (the Delete key does too, while editing points)"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                      Delete point
                  </Button>
              </StackPanel>
              <StackPanel Spacing="1" VerticalAlignment="Center">
                  <Button Name="CloseShapeButton" Classes="small" Command="{Binding CloseShapeCommand}"
                          ToolTip.Tip="Join the line's two ends into a closed shape, which Shape Fill fills"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                      Close shape
                  </Button>
                  <Button Name="OpenShapeButton" Classes="small" Command="{Binding OpenShapeCommand}"
                          ToolTip.Tip="Cut the shape open at the selected point, leaving a line whose ends can be pulled apart"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                      Open at point
                  </Button>
              </StackPanel>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Points" />
      </DockPanel>
      <Rectangle Classes="divider" />
      <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
              <RadioButton Name="ShapeBehindButton" Classes="tool" GroupName="ShapeLayer"
                           Theme="{StaticResource {x:Type ToggleButton}}"
                           IsChecked="{Binding IsElementBehind}"
                           ToolTip.Tip="Scenery: drawn behind the panel's characters">
                  <StackPanel>
                      <PathIcon Data="{StaticResource BehindIcon}" /><TextBlock Text="Background" />
                  </StackPanel>
              </RadioButton>
              <RadioButton Name="ShapeInFrontButton" Classes="tool" GroupName="ShapeLayer"
                           Theme="{StaticResource {x:Type ToggleButton}}"
                           IsChecked="{Binding IsElementInFront}"
                           ToolTip.Tip="Foreground: drawn in front of the panel's characters (bubbles stay on top)">
                  <StackPanel>
                      <PathIcon Data="{StaticResource InFrontIcon}" /><TextBlock Text="Foreground" />
                  </StackPanel>
              </RadioButton>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Layer" />
      </DockPanel>
      <Rectangle Classes="divider" />
      <DockPanel Classes="group">
          <StackPanel Orientation="Horizontal">
              <StackPanel VerticalAlignment="Center" Spacing="1">
                  <Button Classes="small" Command="{Binding BringToFrontCommand}"
                          ToolTip.Tip="In front of everything in the panel except bubbles"
                          HorizontalAlignment="Stretch">
                      To front
                  </Button>
                  <Button Classes="small" Command="{Binding SendToBackCommand}"
                          ToolTip.Tip="Behind everything in the panel" HorizontalAlignment="Stretch">
                      To back
                  </Button>
              </StackPanel>
              <Button Name="DeleteShapeButton" Classes="tool" Command="{Binding DeleteSelectionCommand}"
                      ToolTip.Tip="Delete this shape" local:Shortcut.Keys="Del">
                  <StackPanel>
                      <PathIcon Data="{StaticResource DeleteIcon}" /><TextBlock Text="Delete" />
                  </StackPanel>
              </Button>
          </StackPanel>
          <TextBlock Classes="groupLabel" Text="Arrange" />
      </DockPanel>
  </StackPanel>
</UserControl>
