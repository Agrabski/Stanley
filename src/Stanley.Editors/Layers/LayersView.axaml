<!--
  The Layers pane (docked right of the editors): the current page's panels and what each
  holds, from the front to the back as it's drawn. Click a row to select it on the page; the
  highlight follows what's selected there too. Drag a bubble, character or drawing up or down
  to put it in front of or behind the others in its panel. Like the page navigator it's not an editor -
  the ribbon keeps showing whatever is being edited. Rows highlight themselves
  (LayerRow.IsSelected) rather than through a list box's selection, since Shift+click can
  select several layers at once.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.LayersView"
             x:DataType="local:LayersViewModel">
    <UserControl.Styles>
        <Style Selector="Border.layerRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="Border.layerRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource StanleyHoverTintBrush}" />
        </Style>
        <Style Selector="Border.layerRow.selected">
            <Setter Property="Background" Value="{DynamicResource StanleySelectedTintBrush}" />
        </Style>
        <Style Selector="Border.layerRow.selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource StanleySelectedHoverTintBrush}" />
        </Style>
        <Style Selector="Border.layerRow.selected TextBlock.name">
            <Setter Property="Foreground" Value="{DynamicResource StanleySelectionBrush}" />
        </Style>
        <Style Selector="Border.layerRow.dragged">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button.layerTool">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="Button.layerTool PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="Button.expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <DockPanel Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <!-- Move the selected layer: all the way to the front, one place forward, one place back, all the way to the back. -->
        <Border DockPanel.Dock="Top" Padding="6,4" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Name="BringToFrontButton" Classes="layerTool" Command="{Binding BringToFrontCommand}"
                        ToolTip.Tip="{Binding BringToFrontTip}" ToolTip.ShowOnDisabled="True">
                    <PathIcon Data="{StaticResource InFrontIcon}" />
                </Button>
                <Button Name="BringForwardButton" Classes="layerTool" Command="{Binding BringForwardCommand}"
                        ToolTip.Tip="{Binding BringForwardTip}" ToolTip.ShowOnDisabled="True">
                    <PathIcon Data="{StaticResource ForwardIcon}" />
                </Button>
                <Button Name="SendBackwardButton" Classes="layerTool" Command="{Binding SendBackwardCommand}"
                        ToolTip.Tip="{Binding SendBackwardTip}" ToolTip.ShowOnDisabled="True">
                    <PathIcon Data="{StaticResource BackwardIcon}" />
                </Button>
                <Button Name="SendToBackButton" Classes="layerTool" Command="{Binding SendToBackCommand}"
                        ToolTip.Tip="{Binding SendToBackTip}" ToolTip.ShowOnDisabled="True">
                    <PathIcon Data="{StaticResource BehindIcon}" />
                </Button>
            </StackPanel>
        </Border>
        <TextBlock Name="LayersPlaceholder" DockPanel.Dock="Top" Text="Nothing to show yet." TextWrapping="Wrap" Opacity="0.7"
                   FontSize="12" Margin="12" IsVisible="{Binding !HasRows}" />
        <ScrollViewer Name="LayerScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="LayerList" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:LayerRow">
                        <Panel>
                            <Border Classes="layerRow" Classes.selected="{Binding IsSelected}" Classes.dragged="{Binding IsDragged}" ToolTip.Tip="{Binding Tip}">
                                <DockPanel Margin="{Binding Indent}">
                                    <!-- A panel's arrow opens and closes its layers. -->
                                    <Button Classes="expander" DockPanel.Dock="Left" IsVisible="{Binding IsPanel}"
                                            Command="{Binding ToggleCommand}" Focusable="False" ToolTip.Tip="Show or hide this panel's layers">
                                        <Panel>
                                            <PathIcon Data="M7,10 L12,15 L17,10 Z" Width="12" Height="12" IsVisible="{Binding IsExpanded}" />
                                            <PathIcon Data="M10,7 L15,12 L10,17 Z" Width="12" Height="12" IsVisible="{Binding !IsExpanded}" />
                                        </Panel>
                                    </Button>
                                    <PathIcon DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                              Data="{Binding IconKey, Converter={x:Static local:IconKeyConverter.Instance}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Classes="name" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                   FontWeight="{Binding LabelWeight}" />
                                        <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="11" Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <!-- Where a dragged layer would land: just above this row. -->
                            <Rectangle Name="DropLine" Height="2" VerticalAlignment="Top" Margin="{Binding Indent}" IsHitTestVisible="False"
                                       Fill="{DynamicResource StanleySelectionBrush}" IsVisible="{Binding ShowDropLine}" />
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
