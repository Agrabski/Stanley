    <StreamGeometry x:Key="InFrontIcon">M3,3 H15 V7 H13 V5 H5 V13 H7 V15 H3 Z M9,9 H21 V21 H9 Z</StreamGeometry>
    <!-- One place towards the front / the back (the Layers pane's arrows). -->
    <StreamGeometry x:Key="ForwardIcon">M12,3 L19,11 H14 V21 H10 V11 H5 Z</StreamGeometry>
    <StreamGeometry x:Key="BackwardIcon">M12,21 L5,13 H10 V3 H14 V13 H19 Z</StreamGeometry>
    <StreamGeometry x:Key="BackgroundIcon">M2,4 H22 V20 H2 Z M4,6 V14.5 L9,10 L13,14 L16,11 L20,15 V6 Z</StreamGeometry>
    <StreamGeometry x:Key="AlignLeftIcon">M3,4 H21 V6 H3 Z M3,9 H15 V11 H3 Z M3,14 H21 V16 H3 Z M3,19 H15 V21 H3 Z</StreamGeometry>
    <StreamGeometry x:Key="AlignCenterIcon">M3,4 H21 V6 H3 Z M6,9 H18 V11 H6 Z M3,14 H21 V16 H3 Z M6,19 H18 V21 H6 Z</StreamGeometry>
    <StreamGeometry x:Key="AlignRightIcon">M3,4 H21 V6 H3 Z M9,9 H21 V11 H9 Z M3,14 H21 V16 H3 Z M9,19 H21 V21 H9 Z</StreamGeometry>
    <StreamGeometry x:Key="ShapeFillIcon">M7,1 L13,7 L7,13 L1,7 Z M7,3.8 L10.2,7 L3.8,7 Z M6.2,0.2 L7.6,1.6 L4.4,4.8 L3,3.4 Z M15,7.5 C15,7.5 13.3,9.8 13.3,11 C13.3,12 14.1,12.8 15,12.8 C15.9,12.8 16.7,12 16.7,11 C16.7,9.8 15,7.5 15,7.5 Z</StreamGeometry>
    <StreamGeometry x:Key="ShapeOutlineIcon">M1,15 L2,11 L11,2 L14,5 L5,14 Z M12,1 L13,0 L16,3 L15,4 Z</StreamGeometry>
    <StreamGeometry x:Key="TextFillIcon">M6,0 H9 L15,15 H12 L10.6,11 H4.4 L3,15 H0 Z M5.3,8.5 H9.7 L7.5,2.5 Z</StreamGeometry>
    <StreamGeometry x:Key="TitlePageIcon">M5,2 H19 V22 H5 Z M7,4 V20 H17 V4 Z M8,6 H16 V10 H8 Z M9.5,12 H14.5 V13.5 H9.5 Z M9,17 H15 V18.5 H9 Z</StreamGeometry>
    <StreamGeometry x:Key="PanelBorderIcon">M2,2 H22 V22 H2 Z M5,5 V19 H19 V5 Z</StreamGeometry>
    <StreamGeometry x:Key="LockIcon">M12,2 A5,5 0 0 0 7,7 V10 H6 C4.9,10 4,10.9 4,12 V20 C4,21.1 4.9,22 6,22 H18 C19.1,22 20,21.1 20,20 V12 C20,10.9 19.1,10 18,10 H17 V7 A5,5 0 0 0 12,2 Z M12,4.5 A2.5,2.5 0 0 1 14.5,7 V10 H9.5 V7 A2.5,2.5 0 0 1 12,4.5 Z</StreamGeometry>
    <!-- A burst of tapered wedges radiating out from a small clear gap in the middle - speed lines, in miniature. -->
    <StreamGeometry x:Key="SpeedLinesIcon">M15,12 L23,13.3 L23,10.7 Z M14.1,14.1 L18.9,20.7 L20.7,18.9 Z M12,15 L10.7,23 L13.3,23 Z M9.9,14.1 L3.3,18.9 L5.1,20.7 Z M9,12 L1,10.7 L1,13.3 Z M9.9,9.9 L5.1,3.3 L3.3,5.1 Z M12,9 L13.3,1 L10.7,1 Z M14.1,9.9 L20.7,5.1 L18.9,3.3 Z</StreamGeometry>
    <!-- A die's three-pip face, punched out of a solid square - Shuffle. -->
    <StreamGeometry x:Key="ShuffleIcon">M3,3 H21 V21 H3 Z M7,7 V9.6 H9.6 V7 Z M10.7,10.7 V13.3 H13.3 V10.7 Z M14.4,14.4 V17 H17 V14.4 Z</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Border.ribbon">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <!-- A ribbon group: its controls along the top, its name pinned to the bottom, so
       every group's label lines up the way Word's do. -->
  <Style Selector="StackPanel.group">
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Spacing" Value="2" />
  </Style>
  <Style Selector="DockPanel.group">
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="LastChildFill" Value="False" />
  </Style>
  <Style Selector="DockPanel.group > :is(Control)">
    <Setter Property="DockPanel.Dock" Value="Top" />
  </Style>
  <Style Selector="DockPanel.group > TextBlock.groupLabel">
    <Setter Property="DockPanel.Dock" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style Selector="TextBlock.groupLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource StanleyGroupLabelBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Rectangle.divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="2,4" />
    <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
  </Style>

  <!-- A contextual section: groups that only appear for the current selection, marked
       with a coloured band and title the way Office marks contextual tabs. -->
  <Style Selector="Border.context">
    <Setter Property="BorderThickness" Value="0,3,0,0" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Padding" Value="0,0,0,0" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Border.context.panel">
    <Setter Property="BorderBrush" Value="#257AE8" />
    <Setter Property="Background" Value="#10257AE8" />
  </Style>
  <Style Selector="Border.context.bubble">
    <Setter Property="BorderBrush" Value="#F58A07" />
    <Setter Property="Background" Value="#12F58A07" />
  </Style>
  <Style Selector="TextBlock.contextTitle">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="8,1,0,0" />
  </Style>
  <Style Selector="Border.context.panel TextBlock.contextTitle">
    <Setter Property="Foreground" Value="{DynamicResource StanleyPanelTextBrush}" />
  </Style>
  <Style Selector="Border.context.bubble TextBlock.contextTitle">
    <Setter Property="Foreground" Value="{DynamicResource StanleyBubbleTextBrush}" />
  </Style>

  <!-- Word-style tab strip: compact headers, the content row a fixed height so the page
       below doesn't move when switching tabs. -->
  <Style Selector="TabControl.ribbonTabs">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabControl.ribbonTabs TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource StanleyTabHeaderBrush}" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="TabControl.ribbonTabs TabItem.contextual.panel">
    <Setter Property="Background" Value="#1A257AE8" />
  </Style>
  <Style Selector="TextBlock.panelHeader">
    <Setter Property="Foreground" Value="{DynamicResource StanleyPanelTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TabControl.ribbonTabs TabItem.contextual.bubble">
    <Setter Property="Background" Value="#1FF58A07" />
  </Style>
  <Style Selector="TextBlock.bubbleHeader">
    <Setter Property="Foreground" Value="{DynamicResource StanleyBubbleTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TabControl.ribbonTabs TabItem.contextual.character">
    <Setter Property="Background" Value="#1A2E9E5B" />
  </Style>
  <Style Selector="TextBlock.characterHeader">
    <Setter Property="Foreground" Value="{DynamicResource StanleyCharacterTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TabControl.ribbonTabs TabItem.contextual.shape">
    <Setter Property="Background" Value="#1A8E44AD" />
  </Style>
  <Style Selector="TextBlock.shapeHeader">
    <Setter Property="Foreground" Value="{DynamicResource StanleyShapeTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TabControl.ribbonTabs TabItem.contextual.lettering">
    <Setter Property="Background" Value="#1A117A9C" />
  </Style>
  <Style Selector="TextBlock.letteringHeader">
    <Setter Property="Foreground" Value="{DynamicResource StanleyLetteringTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Word's colour buttons (Shape Fill, Shape Outline, Text Fill, Text Outline): a small split
       button - icon over a colour bar, and a name; the arrow opens the colour menu. -->
  <Style Selector="SplitButton.colorMenu">
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="132" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="SplitButton.colorMenu /template/ Button">
    <Setter Property="Focusable" Value="False" />
  </Style>
  <!-- The colour menu's palette: one menu row holding the swatches, which light up (orange,
       as in Word) under the pointer - the row itself doesn't. -->
  <Style Selector="MenuItem.palette">
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="MenuItem.palette:pointerover /template/ Border">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="MenuItem.palette:selected /template/ Border">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.swatch">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="BorderBrush" Value="#50000000" />
    <Setter Property="BorderThickness" Value="0.8" />
  </Style>
  <Style Selector="Border.chip.current, Button.swatch:pointerover Border.chip">
    <Setter Property="BorderBrush" Value="#F58A07" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TabControl.ribbonTabs TabItem.contextual.sticker">
    <Setter Property="Background" Value="#1FF58A07" />
  </Style>
  <Style Selector="TextBlock.stickerHeader">
    <Setter Property="Foreground" Value="{DynamicResource StanleyBubbleTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- A slot's gallery on the Look tab: label and what's worn, opening the choices. -->
  <Style Selector="DropDownButton.slotGallery">
    <Setter Property="Width" Value="84" />
    <Setter Property="Height" Value="64" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="DropDownButton.slotGallery.compact">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="31" />
    <Setter Property="Margin" Value="0,0,2,2" />
    <Setter Property="Padding" Value="2,0" />
  </Style>
  <Style Selector="DropDownButton.colorSlot">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.choice.worn">
    <Setter Property="BorderBrush" Value="{DynamicResource StanleySelectionBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <!-- A labelled slider row in the character ribbon: name, slider, value. -->
  <Style Selector="Slider.body">
    <Setter Property="Width" Value="130" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <!-- Word's font box: every font by name, each shown in its own face. -->
  <Style Selector="ComboBox.fontBox">
    <Setter Property="Width" Value="170" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="6,0,0,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MaxDropDownHeight" Value="380" />
    <Setter Property="ItemTemplate">
      <DataTemplate x:DataType="local:FontChoice">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" FontSize="10" Opacity="0.6" Margin="8,0,0,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Name}" FontFamily="{Binding Preview}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>
      </DataTemplate>
    </Setter>
  </Style>
  <!-- The note after File › Export (and anything like it): a card over the corner of the page, above the status bar. -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource StanleyBackstageBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StanleyThumbBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BoxShadow" Value="0 4 16 0 #40000000" />
  </Style>
  <Style Selector="StackPanel.tabContent">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Height" Value="92" />
    <Setter Property="Margin" Value="4,4,4,2" />
  </Style>

  <!-- Title row with the quick access toolbar. -->
  <Style Selector="Border.titleBar">
    <Setter Property="Background" Value="{DynamicResource StanleyChromeBrush}" />
    <Setter Property="Height" Value="32" />
  </Style>
  <Style Selector="ToggleSwitch.autoSave">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,-4,0,-4" />
  </Style>
  <Style Selector="Button.qat">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.qat PathIcon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>
  <Style Selector="Button.qat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StanleyChromeHoverBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.qat:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#70FFFFFF" />
  </Style>

  <!-- The File button: Word's coloured tab that opens the backstage view. -->
  <Style Selector="Button.fileTab">
    <Setter Property="Background" Value="{DynamicResource StanleyChromeBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Width" Value="58" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.fileTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StanleyChromeHoverBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Backstage (File) view -->
  <Style Selector="Border.backstageRail">
    <Setter Property="Background" Value="{DynamicResource StanleyChromeBrush}" />
  </Style>
  <Style Selector="Border.backstageRail :is(Button)">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="24,10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Border.backstageRail :is(Button):pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StanleyChromeHoverBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.backstageRail :is(Button):checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StanleyChromeCheckedBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.backstageRail :is(Button):disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#80FFFFFF" />
  </Style>
  <Style Selector="Border.backstageRail PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="TextBlock.backstageHeading">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="Margin" Value="0,0,0,18" />
  </Style>
  <!-- Filter chips (File › My Assets' kinds): a pill each, the chosen one filled. -->
  <Style Selector="RadioButton.chip">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.backstageSubheading">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,18,0,8" />
  </Style>
  <Style Selector="Button.tile">
    <Setter Property="Width" Value="120" />
    <Setter Property="Height" Value="150" />
    <Setter Property="Margin" Value="0,0,12,12" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
  </Style>
  <Style Selector="Button.listEntry">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!-- Ribbon buttons never take keyboard focus, so Delete/arrow keys/shortcuts keep
       going to the page after a ribbon click. -->
  <Style Selector=":is(Button).tool, :is(Button).small">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(Button).tool">
    <Setter Property="MinWidth" Value="58" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Padding" Value="4,4" />
    <Setter Property="Margin" Value="1,0" />
  </Style>
  <Style Selector=":is(Button).tool PathIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(Button).tool TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>
  <Style Selector=":is(Button).small">
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector=":is(Button).small PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <!-- A sticker on offer in a slot's gallery: a full figure, or a head close-up. After
       .small, whose height it overrides. -->
  <Style Selector=":is(Button).small.choice.sticker">
    <Setter Property="Width" Value="66" />
    <Setter Property="Height" Value="104" />
  </Style>
  <Style Selector=":is(Button).small.choice.sticker.closeup">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="80" />
  </Style>
  <!-- The expression gallery's tiny draw buttons (+, pen) under a mix-your-own row's name. -->
  <Style Selector=":is(Button).small.faceDraw">
    <Setter Property="Width" Value="18" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector=":is(Button).small.faceDraw PathIcon">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
  </Style>
  <!-- A smaller close-up, for a row of eyes, brows or mouths in the expression gallery's "mix your own". -->
  <Style Selector=":is(Button).small.choice.sticker.closeup.mini">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="56" />
  </Style>
</Styles>
