<!--
  The ribbon's Font group - one control, the same on every tab that letters something
  (Home, Bubble, Text), like Word's: typeface, size (pick or type), bigger/smaller,
  bold, italic and alignment, for the selected bubble or text or what's added next.
  Its DataContext is the page editor's view model (see PageEditorViewModel.Fonts.cs).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stanley.Editors"
             x:Class="Stanley.Editors.FontGroup"
             x:DataType="local:PageEditorViewModel">
  <DockPanel Classes="group">
    <StackPanel Spacing="2" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="1">
        <ComboBox Name="FontBox" Classes="fontBox" Margin="0,0,3,0" ItemsSource="{Binding FontChoices}" SelectedItem="{Binding SelectedFont}"
                  PlaceholderText="{Binding FontPlaceholder}" ToolTip.Tip="{Binding FontTip}" />
        <local:FontSizeBox Name="SizeBox" Margin="0,0,3,0" Value="{Binding TextSizeMm}" Sizes="{Binding TextSizeChoices}" Command="{Binding SetTextSizeCommand}"
                           ToolTip.Tip="Font Size - the letters' height in millimetres: pick one, or type any size and press Enter" />
        <Button Name="BiggerButton" Classes="small" Command="{Binding BiggerTextCommand}" ToolTip.Tip="Bigger letters" FontWeight="SemiBold">A+</Button>
        <Button Name="SmallerButton" Classes="small" Command="{Binding SmallerTextCommand}" ToolTip.Tip="Smaller letters">A−</Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="1">
        <ToggleButton Name="BoldButton" Classes="small" IsChecked="{Binding IsTextBold}" ToolTip.Tip="Bold" FontWeight="Bold" Focusable="False">B</ToggleButton>
        <ToggleButton Name="ItalicButton" Classes="small" IsChecked="{Binding IsTextItalic}" ToolTip.Tip="Italic" FontStyle="Italic" Focusable="False">I</ToggleButton>
        <RadioButton Name="AlignLeftButton" Classes="small" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsTextAlignLeft}" ToolTip.Tip="Line up on the left"><PathIcon Data="{StaticResource AlignLeftIcon}" /></RadioButton>
        <RadioButton Name="AlignCenterButton" Classes="small" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsTextAlignCenter}" ToolTip.Tip="Centre each line"><PathIcon Data="{StaticResource AlignCenterIcon}" /></RadioButton>
        <RadioButton Name="AlignRightButton" Classes="small" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsTextAlignRight}" ToolTip.Tip="Line up on the right"><PathIcon Data="{StaticResource AlignRightIcon}" /></RadioButton>
      </StackPanel>
    </StackPanel>
    <TextBlock Classes="groupLabel" Text="Font" />
  </DockPanel>
</UserControl>
